  .b-cena svg { display: block; width: 100%; height: 100%; }
  .b-balao { --x: -50%; position: absolute; transform: translateX(var(--x)); transform-origin: 50% 100%; padding: 8px 12px; border: 2px solid var(--tinta); border-radius: 12px; background: var(--branco); box-shadow: 0 3px 0 var(--tinta); font-weight: 700; font-size: clamp(12px, 1.1vw, 15px); white-space: nowrap; }
  .b-balao::after { content: ""; position: absolute; left: 50%; bottom: -9px; width: 12px; height: 12px; background: var(--branco); border: 2px solid var(--tinta); border-top: 0; border-left: 0; transform: translateX(-50%) rotate(45deg); }
  .b-balao--dir { --x: -10%; transform-origin: 12% 100%; }
  .b-balao--dir::after { left: 12%; }

  /* Scene animation. Frame-based steps() keep the motion in pixels: nothing glides. SVG
     transforms here are in scene units, so 1px is one pixel of the art. */
  .b-l--nuvem-0 { animation: b-deriva 26s steps(7) infinite; }
  .b-l--nuvem-1 { animation: b-deriva 34s steps(7) -12s infinite; }
  .b-l--nuvem-2 { animation: b-deriva 30s steps(7) -20s infinite; }
  .b-l--raios { animation: b-pisca 3.2s steps(1) infinite; }
  .b-l--luz { animation: b-pisca 1.1s steps(1) infinite; }
  .b-l--passaro-a, .b-l--passaro-b { animation: b-voo 22s steps(150) infinite, b-pisca 0.5s steps(1) infinite; }
  .b-l--passaro-b { animation-delay: 0s, -0.25s; }
  .b-l--fumaca-0, .b-l--fumaca-1, .b-l--fumaca-2 { opacity: 0; animation: b-fumaca 3s steps(6) infinite; }
  .b-l--fumaca-1 { animation-delay: -1s; }
  .b-l--fumaca-2 { animation-delay: -2s; }
  .b-l--pessoa-1 { animation: b-respira 1.6s steps(1) infinite; }
  .b-l--pessoa-2 { animation: b-respira 1.3s steps(1) -0.5s infinite; }
  /* The bubbles take turns, as a short exchange: the question, then the answer. */
  .b-balao--esq { animation: b-fala-1 9s steps(1) infinite; }
  .b-balao--dir { animation: b-fala-2 9s steps(1) infinite; }

  @keyframes b-deriva { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(14px); } }
  @keyframes b-pisca { 0% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes b-respira { 0% { transform: translateY(0); } 50% { transform: translateY(-1px); } }
  @keyframes b-voo { 0% { transform: translate(-20px, 0); } 25% { transform: translate(110px, -3px); } 50% { transform: translate(240px, 0); } 75% { transform: translate(370px, -3px); } 100% { transform: translate(500px, 0); } }
  @keyframes b-fumaca { 0% { opacity: 0.9; transform: translate(0, 0); } 100% { opacity: 0; transform: translate(-6px, -12px); } }
  @keyframes b-fala-1 {
    0% { opacity: 0; transform: translateX(var(--x)) scale(0.6); }
    3% { opacity: 1; transform: translateX(var(--x)) scale(0.85); }
