  /* Type */
  .b-h1 { margin: 0; max-width: 900px; font-family: var(--fonte-titulo); font-weight: 750; font-size: clamp(42px, 7vw, 92px); line-height: 0.98; letter-spacing: -0.045em; text-wrap: balance; }
  .b-h2 { margin: 0; font-family: var(--fonte-titulo); font-weight: 720; font-size: clamp(30px, 4.2vw, 48px); line-height: 1.04; letter-spacing: -0.035em; text-wrap: balance; }
