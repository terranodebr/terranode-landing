  .b-nota { margin: 0; font-size: 14px; color: var(--tinta-2); }
  .b-mark-verde { background: var(--lima); }

  /* Chunky buttons: 2px ink border and a hard shadow that the press flattens. */
  .b-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; padding: 0 22px; box-sizing: border-box; border: 2px solid var(--tinta); border-radius: 12px; background: var(--branco); color: var(--tinta); box-shadow: 0 4px 0 var(--tinta); font-family: var(--fonte-texto); font-weight: 700; font-size: 16px; line-height: 1.2; text-align: center; cursor: pointer; transition: transform 0.08s, box-shadow 0.08s; }
