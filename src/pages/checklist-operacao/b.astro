  /* Hero */
  .b-hero { display: flex; flex-direction: column; align-items: center; gap: 22px; padding: clamp(48px, 8vw, 96px) clamp(16px, 4vw, 40px) clamp(24px, 3vw, 32px); text-align: center; }
  .b-acoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  .b-cena { position: relative; height: clamp(250px, 30vw, 440px); overflow: hidden; background: linear-gradient(var(--papel) 0 66.6%, #C9774A 66.6%); }
