---
// /checklist-operacao/b/: variant B of the checklist for an A/B test against
// /checklist-operacao/. Same statements, scoring, forms and events (src/lib/checklist.ts and
// src/lib/checklist-app.ts); only the design differs. B leaves the TerraNode look behind for
// a playful one: warm paper, chunky bordered buttons with a hard shadow, a lime highlight,
// Bricolage Grotesque over Atkinson Hyperlegible, and a pixel-art field scene drawn here.
//
// Always noindex: it is a test variant of A, which is the page that may be indexed. The
// styles are scoped to this file, so nothing here touches global.css.
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import Base from "../../layouts/Base.astro";
import { asset } from "../../lib/asset";
import { AREAS, LINKS, RESPOSTAS, TOTAL_AFIRMACOES, chave } from "../../lib/checklist";

// Its own title, description and share image, so a shared B link looks like B and the two
// variants can be told apart wherever the link shows up.
const title = "Onde a rotina da sua equipe de campo trava? · Checklist gratuito";
const description =
  "15 afirmações, 4 minutos, resultado na hora e sem cadastro. Descubra qual área da rotina da sua equipe de campo merece atenção primeiro.";

// ---------- Pixel art ----------
// Everything is drawn on a grid of 1-unit squares and rendered with crispEdges, so it
// scales up as pixels. Terrain uses fixed formulas and a seeded generator, so every build
// draws the same scene. Each part goes into a named layer (a <g>), drawn in the order the
// layers were created, so the moving parts can be animated on their own in the CSS below.
type Px = { x: number; y: number; w: number; h: number; c: string };
const W = 480;
const H = 96;
let semente = 7;
const aleatorio = () => ((semente = (semente * 16807) % 2147483647) / 2147483647);

const camadas: Record<string, Px[]> = {};
let camada = "fundo";
const em = (nome: string, desenhar: () => void) => { const antes = camada; camada = nome; desenhar(); camada = antes; };
const px = (x: number, y: number, w: number, h: number, c: string) => (camadas[camada] ??= []).push({ x, y, w, h, c });

// Sun, with rays that blink, and three clouds that drift.
em("sol", () => [[2, 0, 6], [1, 1, 8], [0, 2, 10], [0, 3, 10], [0, 4, 10], [0, 5, 10], [0, 6, 10], [1, 7, 8], [2, 8, 6]].forEach(([dx, dy, w]) => px(420 + dx, 8 + dy, w, 1, "#FFC247")));
em("raios", () => { px(424, 3, 2, 2, "#FFC247"); px(424, 19, 2, 2, "#FFC247"); px(414, 12, 2, 2, "#FFC247"); px(434, 12, 2, 2, "#FFC247"); px(416, 5, 1, 1, "#FFC247"); px(433, 5, 1, 1, "#FFC247"); px(416, 18, 1, 1, "#FFC247"); px(433, 18, 1, 1, "#FFC247"); });
[[40, 14], [150, 8], [330, 18]].forEach(([cx, cy], i) => em(`nuvem-${i}`, () => {
  px(cx + 4, cy, 10, 2, "#FFFFFF"); px(cx, cy + 2, 22, 3, "#FFFFFF"); px(cx + 2, cy + 5, 16, 1, "#F1ECE0");
}));
// A bird crossing the sky, in two frames: wings up and wings down.
em("passaro-a", () => { px(0, 24, 1, 1, "#15201A"); px(1, 25, 1, 1, "#15201A"); px(2, 26, 1, 1, "#15201A"); px(3, 25, 1, 1, "#15201A"); px(4, 24, 1, 1, "#15201A"); });
em("passaro-b", () => { px(0, 26, 1, 1, "#15201A"); px(1, 25, 1, 1, "#15201A"); px(2, 26, 1, 1, "#15201A"); px(3, 25, 1, 1, "#15201A"); px(4, 26, 1, 1, "#15201A"); });

// Far and near hills, stepped every 4 units.
for (let x = 0; x < W; x += 4) {
  const longe = Math.round(16 + 7 * Math.sin(x / 41) + 4 * Math.sin(x / 13 + 1));
  px(x, 64 - longe, 4, longe, "#D3DDB2");
}
for (let x = 0; x < W; x += 4) {
  const perto = Math.round(8 + 5 * Math.sin(x / 31 + 2) + 2 * Math.sin(x / 9));
  px(x, 66 - perto, 4, perto, "#AFC584");
}
// Red earth, a dirt track and pebbles.
px(0, 64, W, 32, "#C9774A");
px(0, 78, W, 6, "#DEA678");
for (let i = 0; i < 70; i++) {
  const x = Math.floor(aleatorio() * W);
  const y = 66 + Math.floor(aleatorio() * 28);
  if (y >= 78 && y < 84) continue;
  px(x, y, 2, 1, aleatorio() > 0.5 ? "#AD5F33" : "#D98C5C");
}
for (let i = 0; i < 40; i++) px(Math.floor(aleatorio() * W), 64 + Math.floor(aleatorio() * 3), 1, 2, "#6E8F3A");
// Scrub trees.
for (const x of [18, 74, 128, 318, 368, 448]) {
  px(x, 52, 2, 13, "#6B4026");
  px(x - 6, 44, 14, 6, "#5E7E2E"); px(x - 4, 40, 10, 4, "#5E7E2E"); px(x - 8, 47, 6, 3, "#5E7E2E");
  px(x - 2, 41, 4, 2, "#7FA03E"); px(x + 3, 45, 3, 2, "#7FA03E");
}
// Pickup truck, parked left of the crew, idling: puffs leave the tailpipe at its back.
[0, 1, 2].forEach((i) => em(`fumaca-${i}`, () => px(156, 67, 2, 2, "#C9C3B4")));
{
  const x = 160;
  px(x, 64, 26, 8, "#F4F2EA"); px(x + 25, 58, 14, 14, "#F4F2EA"); px(x + 38, 64, 9, 8, "#F4F2EA");
  px(x + 28, 60, 9, 5, "#7FA6C0"); px(x + 46, 66, 1, 2, "#FFC247"); px(x, 70, 47, 2, "#D9D4C6");
  px(x - 1, 63, 28, 1, "#B9B3A4"); px(x - 2, 69, 3, 1, "#5A4636");
  for (const r of [x + 6, x + 34]) { px(r, 70, 7, 7, "#1E2421"); px(r + 2, 72, 3, 3, "#9AA29F"); }
}
// Surveyor's tripod, with a status light that blinks.
em("tripe", () => {
  const x = 300;
  for (let i = 0; i < 14; i++) { px(x - Math.floor(i / 2), 64 + i, 1, 1, "#5A4636"); px(x + 4 + Math.floor(i / 2), 64 + i, 1, 1, "#5A4636"); px(x + 2, 64 + i, 1, 1, "#5A4636"); }
  px(x - 1, 58, 7, 6, "#F26B3A"); px(x + 5, 60, 3, 2, "#1E2421"); px(x + 1, 63, 3, 1, "#1E2421");
});
em("luz", () => px(300, 59, 2, 1, "#D7F27A"));
// Two crew members: one with a stack of papers, one on the phone in a hard hat. Each sits
// in its own layer so it can shift its weight.
function pessoa(x: number, capacete: boolean, telefone: boolean) {
  px(x, 70, 2, 8, "#2B3A55"); px(x + 3, 70, 2, 8, "#2B3A55"); px(x - 1, 78, 3, 1, "#1E2421"); px(x + 3, 78, 3, 1, "#1E2421");
  px(x - 1, 61, 7, 9, "#3B3F46"); px(x - 1, 61, 2, 9, "#FF7A2E"); px(x + 4, 61, 2, 9, "#FF7A2E"); px(x - 1, 66, 7, 1, "#F2EFD8");
  px(x, 55, 5, 6, "#C58A5F"); px(x + 1, 58, 1, 1, "#2A1F18"); px(x + 3, 58, 1, 1, "#2A1F18");
  if (capacete) { px(x - 1, 53, 7, 3, "#FFC247"); px(x - 2, 55, 9, 1, "#E8A92E"); }
  else px(x, 54, 5, 2, "#2A1F18");
  if (telefone) { px(x + 5, 56, 2, 6, "#C58A5F"); px(x + 4, 56, 2, 3, "#1E2421"); px(x - 3, 62, 2, 6, "#C58A5F"); }
  else { px(x - 3, 62, 2, 5, "#C58A5F"); px(x + 6, 62, 2, 5, "#C58A5F"); px(x - 4, 64, 11, 4, "#FFFFFF"); px(x - 3, 63, 9, 1, "#F1ECE0"); px(x - 2, 65, 7, 1, "#B9B3A4"); }
}
em("pessoa-1", () => pessoa(226, false, false));
em("pessoa-2", () => pessoa(252, true, true));

// ---------- Pixel icons, one per area ----------
const MAPAS: Record<string, string[]> = {
  visibilidade: ["...####...", ".##....##.", "#...##...#", "#..####..#", "#...##...#", ".##....##.", "...####..."],
  clareza: ["###...###.", "#.#####.#.", "###...###.", ".......#..", ".......#..", ".....###..", ".....#.#..", ".....###.."],
  consistencia: ["########", "#......#", "########", "........", "########", "#......#", "########", "........", "########", "#......#", "########"],
  medicao: ["..######..", ".#......#.", "#........#", "#.....##.#", "#....##..#", "#...##...#", ".#......#."],
  melhoria: ["..####.#..", ".#....##..", "#....###..", "#.........", ".........#", "..###....#", "..##....#.", "..#.####.."],
};
const icone = (id: string) => {
  const linhas = MAPAS[id];
  const rects: { x: number; y: number }[] = [];
  linhas.forEach((l, y) => [...l].forEach((ch, x) => ch === "#" && rects.push({ x, y })));
  return { w: Math.max(...linhas.map((l) => l.length)), h: linhas.length, rects };
};
const PRANCHETA = ["..####..", "########", "#......#", "#.####.#", "#......#", "#.###..#", "#......#", "########"];

const seta = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const setaVolta = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';
const visto = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>';
---
<Base title={title} description={description} image="/checklist/og-b.jpg" noindex rodape={false}>
  <div class="b">

    <header class="b-topo" data-rolagem-offset>
      <span class="b-topo__marca">
        <svg class="b-pixel" viewBox="0 0 8 8" width="24" height="24" aria-hidden="true">
          {PRANCHETA.flatMap((l, y) => [...l].map((ch, x) => ch === "#" && <rect x={x} y={y} width="1" height="1" />))}
        </svg>
        Checklist de campo
      </span>
      <a href="#desafio" class="b-btn b-btn--ambar b-btn--pequeno" data-mp-cta="checklist_b_topo_desafio">
        <span class="b-so-largo">Desafio grátis · 14 dias</span><span class="b-so-estreito">Desafio grátis</span>
      </a>
    </header>

    <!-- Intro: hero, pixel scene, how it works and the five areas. -->
    <div data-ck-tela="inicio">
      <section class="b-hero">
        <span class="b-selo">Checklist gratuito · cerca de 4 minutos</span>
        <h1 class="b-h1">Onde a rotina da sua equipe de campo <mark>trava?</mark></h1>
        <p class="b-lead">Responda {TOTAL_AFIRMACOES} afirmações sobre como a operação funciona hoje e descubra qual área merece atenção primeiro.</p>
        <div class="b-acoes">
          <button type="button" class="b-btn b-btn--verde" data-ck-comecar>Começar o checklist <span set:html={seta} /></button>
          <button type="button" class="b-btn" data-ck-recomecar hidden>Recomeçar do zero</button>
        </div>
        <p class="b-nota-pilula">Sem cadastro. O resultado aparece na hora.</p>
        <noscript><p class="b-nota-pilula">O checklist precisa de JavaScript para funcionar.</p></noscript>
      </section>

      <!-- The scene keeps its proportions and is centred; narrow screens crop the sides,
           so the crew and their speech bubbles sit in the middle. -->
      <div class="b-cena" aria-hidden="true">
        <div class="b-cena__palco">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" shape-rendering="crispEdges">
            {Object.entries(camadas).map(([nome, rects]) => (
              <g class={`b-l b-l--${nome}`}>{rects.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.c} />)}</g>
            ))}
          </svg>
          <span class="b-balao b-balao--esq" style={`left:${(226 / W) * 100}%; bottom:${(1 - 50 / H) * 100}%`}>Cadê a ficha de ontem?</span>
          <span class="b-balao b-balao--dir" style={`left:${(255 / W) * 100}%; bottom:${(1 - 33 / H) * 100}%`}>Ficou no outro carro!</span>
        </div>
      </div>

      <ul class="b-faixa">
        <li><strong>{TOTAL_AFIRMACOES} afirmações</strong><span>Curtas e sobre a rotina real</span></li>
        <li><strong>5 áreas</strong><span>Da visibilidade à melhoria</span></li>
        <li><strong>4 minutos</strong><span>Dá para fazer no intervalo</span></li>
        <li><strong>Resultado na hora</strong><span>Com uma ação para a semana</span></li>
      </ul>

      <section class="b-escuro">
        <div class="b-escuro__grade">
          <div class="b-escuro__texto">
            <h2 class="b-h2">Responda pela rotina de hoje. <mark class="b-mark-verde">Sem enfeitar.</mark></h2>
            <p class="b-lead b-lead--claro">Uma área por tela, três afirmações em cada uma. Não existe resposta certa: o resultado só é útil se descrever a operação como ela é.</p>
            <ul class="b-lista">
              <li><span class="b-lista__icone b-lista__icone--ambar" set:html={visto} /><span><strong>Uma área por vez</strong>Visibilidade, clareza, consistência, medição e melhoria.</span></li>
              <li><span class="b-lista__icone b-lista__icone--lima" set:html={visto} /><span><strong>Dá para voltar e mudar</strong>Você revisa tudo antes de ver o resultado.</span></li>
              <li><span class="b-lista__icone b-lista__icone--laranja" set:html={visto} /><span><strong>Uma ação para esta semana</strong>Feita em menos de uma hora, com papel ou planilha.</span></li>
            </ul>
          </div>
          <!-- A static preview of a checklist screen. Decorative. -->
          <div class="b-demo" aria-hidden="true">
            <div class="b-demo__progresso"><span class="is-cheio"></span><span></span><span></span><span></span><span></span></div>
            <p class="b-demo__rotulo">Área 1 de 5 · Visibilidade</p>
            <p class="b-demo__texto">Quando uma atividade atrasa, ficamos sabendo no mesmo dia.</p>
            <div class="b-demo__opcoes"><span>Sim</span><span class="is-marcada">Às vezes</span><span>Ainda não</span></div>
            <div class="b-demo__rodape"><span class="b-btn b-btn--pequeno">Voltar</span><span class="b-btn b-btn--verde b-btn--pequeno">Próxima área</span></div>
          </div>
        </div>
      </section>
      <div class="b-degrau b-degrau--escuro-claro" aria-hidden="true"></div>

      <section class="b-areas">
        <h2 class="b-h2">As 5 áreas que você vai avaliar</h2>
        <ol class="b-areas__lista">
          {AREAS.map((a, i) => {
            const ic = icone(a.id);
            return (
              <li class={`b-area-card b-cor-${i}`}>
                <span class="b-area-card__icone">
                  <svg class="b-pixel" viewBox={`0 0 ${ic.w} ${ic.h}`} width="30" height={(30 * ic.h) / ic.w} aria-hidden="true">
                    {ic.rects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" />)}
                  </svg>
                </span>
                <span class="b-area-card__nome">{a.nome}</span>
                <span class="b-area-card__texto">{a.descricao}</span>
              </li>
            );
          })}
        </ol>
        <p class="b-nota">É um exercício de reflexão, não uma auditoria.</p>
      </section>
    </div>

    <!-- Checklist -->
    <section class="b-palco" data-ck-palco hidden>
      <div class="b-cartao">
        <div class="b-progresso">
          <div class="b-progresso__linha">
            <span data-ck-progresso-rotulo></span>
            <span data-ck-progresso-conta></span>
          </div>
          <ol class="b-progresso__barras" aria-hidden="true">
            {AREAS.map((a) => <li data-ck-barra={a.id}></li>)}
          </ol>
        </div>

        <form data-ck-form novalidate>
          {AREAS.map((area, n) => {
            const ic = icone(area.id);
            return (
              <fieldset class="b-area" data-ck-tela={area.id} hidden>
                <legend class="b-area__legenda">
                  <span class="b-sr">Área {n + 1} de {AREAS.length}: </span>
                  <span class={`b-area__icone b-cor-${n}`} aria-hidden="true">
                    <svg class="b-pixel" viewBox={`0 0 ${ic.w} ${ic.h}`} width="28" height={(28 * ic.h) / ic.w}>
                      {ic.rects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" />)}
                    </svg>
                  </span>
                  <span class="b-area__nome" tabindex="-1" data-ck-foco>{area.nome}</span>
                </legend>
                <p class="b-area__descricao">{area.descricao}</p>

                <ol class="b-perguntas">
                  {area.afirmacoes.map((texto, i) => {
                    const k = chave(area, i);
                    return (
                      <li class="b-pergunta" data-ck-pergunta={k}>
                        <fieldset>
                          <legend class="b-pergunta__texto">{texto}</legend>
                          <div class="b-opcoes">
                            {RESPOSTAS.map((r) => (
                              <label class="b-opcao">
                                <input type="radio" name={k} value={r.valor} />
                                <span>{r.rotulo}</span>
                              </label>
                            ))}
                          </div>
                          <p class="b-falta" data-ck-falta hidden>Escolha uma resposta para esta afirmação.</p>
                        </fieldset>
                      </li>
                    );
                  })}
                </ol>

                <div class="b-nav">
                  <button type="button" class="b-btn" data-ck-voltar><span set:html={setaVolta} /> Voltar</button>
                  <button type="button" class="b-btn b-btn--verde" data-ck-avancar>
                    {n < AREAS.length - 1 ? "Próxima área" : "Revisar respostas"} <span set:html={seta} />
                  </button>
                </div>
              </fieldset>
            );
          })}

          <div data-ck-tela="revisao" hidden>
            <h2 class="b-h2 b-h2--cartao" tabindex="-1" data-ck-foco>Confira suas respostas</h2>
            <p class="b-area__descricao">Se quiser mudar alguma, edite a área antes de ver o resultado.</p>
            <ol class="b-revisao">
              {AREAS.map((area) => (
                <li class="b-revisao__area">
                  <div class="b-revisao__topo">
                    <h3>{area.nome}</h3>
                    <button type="button" class="b-link" data-ck-editar={area.id}>Editar<span class="b-sr"> {area.nome}</span></button>
                  </div>
                  <ul>
                    {area.afirmacoes.map((texto, i) => (
                      <li><span class="b-revisao__texto">{texto}</span><span class="b-revisao__resposta" data-ck-resumo={chave(area, i)}></span></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
            <div class="b-nav">
              <button type="button" class="b-btn" data-ck-voltar><span set:html={setaVolta} /> Voltar</button>
              <button type="button" class="b-btn b-btn--verde" data-ck-ver-resultado>Ver meu resultado <span set:html={seta} /></button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- Resultado -->
    <section class="b-resultado" data-ck-tela="resultado" hidden>
      <div class="b-coluna">
        <div class="b-cartao">
          <span class="b-selo">Seu resultado</span>
          <h2 class="b-nivel" tabindex="-1" data-ck-foco><mark data-ck-nivel-nome></mark></h2>
          <p class="b-lead" data-ck-nivel-texto></p>
          <ul class="b-medidores" aria-label="Situação por área">
            {AREAS.map((a) => (
              <li class="b-medidor" data-ck-area-resultado={a.id}>
                <span class="b-medidor__nome">{a.nome}</span>
                <span class="b-medidor__blocos" aria-hidden="true">
                  {Array.from({ length: 6 }, () => <span data-ck-bloco></span>)}
                </span>
                <span class="b-medidor__situacao" data-ck-situacao></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="b-duas" data-ck-destaques>
          <div class="b-cartao b-cartao--lima">
            <span class="b-rotulo">Área mais forte</span>
            <h3 class="b-h3" data-ck-forte-nome></h3>
            <p data-ck-forte-texto></p>
          </div>
          <div class="b-cartao b-cartao--laranja">
            <span class="b-rotulo">Área com mais oportunidade</span>
            <h3 class="b-h3" data-ck-fraca-nome></h3>
            <p data-ck-fraca-texto></p>
          </div>
        </div>
        <p class="b-nota" data-ck-empate hidden>Suas respostas ficaram iguais em todas as áreas. Nesse caso, sugerimos começar por Visibilidade: sem ver o andamento do trabalho, as outras áreas ficam difíceis de atacar.</p>

        <div class="b-cartao b-cartao--ambar">
          <span class="b-rotulo">Para fazer nesta semana</span>
          <p class="b-acao" data-ck-acao></p>
          <p class="b-acao__rodape">Leva menos de uma hora e não precisa de nenhuma ferramenta além de papel ou planilha.</p>
        </div>

        <p class="b-nota">Este resultado é um exercício de reflexão, não uma auditoria. Ele parte só das suas respostas e não mede nem prevê o desempenho da empresa.</p>

        <div class="b-cartao">
          <h2 class="b-h2 b-h2--cartao">Receba o resultado do seu checklist</h2>
          <p class="b-area__descricao">Enviamos seu resultado, a área que merece atenção primeiro e uma sugestão prática para começar.</p>
          <form class="b-form" data-ck-enviar="resultado" novalidate>
            <label class="b-campo">E-mail
              <input name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="b-email-erro" />
            </label>
            <p class="b-falta" id="b-email-erro" data-ck-erro hidden>Informe um e-mail válido.</p>
            <div class="b-campos">
              <label class="b-campo"><span>Nome <em>(opcional)</em></span><input name="nome" type="text" autocomplete="name" /></label>
              <label class="b-campo"><span>Empresa <em>(opcional)</em></span><input name="empresa" type="text" autocomplete="organization" /></label>
            </div>
            <label class="b-consentimento"><input type="checkbox" name="marketing" /><span>Quero receber da TerraNode conteúdos sobre melhoria operacional e o convite para o desafio de 14 dias. Posso cancelar quando quiser.</span></label>
            <button type="submit" class="b-btn b-btn--verde">Enviar meu resultado</button>
            <p class="b-aviso">Usaremos seu e-mail para enviar este resultado.
              {LINKS.privacidade ? <a href={LINKS.privacidade}>Política de privacidade</a> : <span class="b-pendente">[Política de privacidade: link pendente]</span>}</p>
            <p class="b-status" data-ck-status role="status" aria-live="polite"></p>
          </form>
        </div>

        <p class="b-refazer"><button type="button" class="b-link" data-ck-refazer>Refazer o checklist</button></p>
      </div>
    </section>

    <!-- The challenge, under every screen. -->
    <div class="b-degrau b-degrau--claro-verde" aria-hidden="true"></div>
    <section id="desafio" class="b-desafio" aria-labelledby="b-desafio-titulo">
      <div class="b-desafio__grade">
        <div>
          <span class="b-selo b-selo--escuro">Bootcamp gratuito · Desafio de 14 dias</span>
          <h2 class="b-h2 b-h2--claro" id="b-desafio-titulo">Transforme uma oportunidade em um plano <mark>prático</mark> de melhoria.</h2>
          <p class="b-lead b-lead--claro">Em 14 dias, você escolhe um processo da sua operação de campo, identifica um gargalo e monta um plano de ação para os próximos 30 dias. A participação é gratuita.</p>
          <ol class="b-calendario" aria-hidden="true">
            {Array.from({ length: 14 }, (_, i) => <li class={i === 0 ? "is-inicio" : i === 13 ? "is-fim" : ""}>{i + 1}</li>)}
          </ol>
          <ol class="b-passos">
            <li><span>1</span>Escolha um processo</li>
            <li><span>2</span>Identifique um gargalo</li>
            <li><span>3</span>Saia com um plano de 30 dias</li>
          </ol>
          {LINKS.dataDesafio
            ? <p class="b-desafio__data">Próxima turma: {LINKS.dataDesafio}</p>
            : <p class="b-pendente">[Data de início e formato do desafio: pendentes]</p>}
        </div>

        <form class="b-form b-cartao" data-ck-enviar="desafio" novalidate>
          <label class="b-campo">E-mail
            <input name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="b-desafio-erro" />
          </label>
          <p class="b-falta" id="b-desafio-erro" data-ck-erro hidden>Informe um e-mail válido.</p>
          <label class="b-campo"><span>Nome <em>(opcional)</em></span><input name="nome" type="text" autocomplete="name" /></label>
          <label class="b-consentimento"><input type="checkbox" name="marketing" /><span>Também quero receber outros conteúdos da TerraNode sobre melhoria operacional. Posso cancelar quando quiser.</span></label>
          <button type="submit" class="b-btn b-btn--ambar b-btn--largo">Quero participar do desafio gratuito <span set:html={seta} /></button>
          <p class="b-aviso">Usaremos seu e-mail para enviar as informações e os conteúdos do desafio.
            {LINKS.privacidade ? <a href={LINKS.privacidade}>Política de privacidade</a> : <span class="b-pendente">[Política de privacidade: link pendente]</span>}</p>
          <p class="b-status" data-ck-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <footer class="b-rodape">
      <span>Um checklist gratuito da <a href={asset("/")}>TerraNode</a>.</span>
      {LINKS.privacidade ? <a href={LINKS.privacidade}>Política de privacidade</a> : <span class="b-pendente">[Política de privacidade: link pendente]</span>}
    </footer>
  </div>
</Base>

<script>
  import { iniciarChecklist } from "../../lib/checklist-app";
  iniciarChecklist("b");
</script>

<style>
  :global(body) { background: #F6F2E8; }

  .b {
