---
// /precos/: the plans and what each one costs, light like the home page. The prices are
// per collector with a minimum, so the page's main device is a calculator drawn as a map's
// scale bar: pick the number of collectors and every card shows the monthly total for it.
// Without JavaScript the calculator stays hidden and the cards show each plan's base price.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Animacoes from "../components/recursos/Animacoes.astro";
import { COMPARACAO, EXTRAS, PLANOS, TESTE, brl, rotuloColetores, totalMensal } from "../lib/planos";

const title = "Preços e planos · TerraNode";
const description =
  "Planos em reais a partir de R$ 1.500 por mês, com projetos, formulários e coletas ilimitados. Compare Essencial, Profissional e Corporativo e veja como funciona o teste de 21 dias.";

const WAITLIST = "https://form.typeform.com/to/ZVQYTFV5";

// The calculator's starting point, and the scale printed under the slider.
const EQUIPE_INICIAL = 5;
const ESCALA = { min: 5, max: 50, marcas: [5, 10, 20, 30, 40, 50] };
const posicao = (v: number) => (v - ESCALA.min) / (ESCALA.max - ESCALA.min);

const planoDoTeste = PLANOS.find((p) => p.id === TESTE.plano)!;
const { valorHora, minimoHoras } = EXTRAS.implementacao;
const [essencial, profissional, corporativo] = PLANOS;

const faq = [
  {
    q: "Já posso contratar?",
    a: "Ainda não. O TerraNode está em pré-lançamento, e quem está na lista de espera é avisado primeiro quando a contratação abrir.",
  },
  {
    q: "Quem entra na conta do preço?",
    a: `Só os coletores, as pessoas que registram dados em campo pelo aplicativo. Gestores e editores não entram na conta. Cada plano tem um número mínimo de coletores, e o valor mensal cobre esse mínimo. Uma equipe menor paga o mesmo valor. Acima do mínimo, cada coletor extra custa ${brl(essencial.extra)} por mês no ${essencial.nome}, ${brl(profissional.extra)} no ${profissional.nome} e ${brl(corporativo.extra)} no ${corporativo.nome}. Com 8 coletores no ${essencial.nome}, são ${brl(totalMensal(essencial, 8))} por mês.`,
  },
  {
    q: `O que o teste de ${TESTE.dias} dias inclui?`,
    a: `Os recursos do plano ${planoDoTeste.nome}, com três limites: não exporta coletas, não gera relatórios e tem 5 GB de armazenamento.`,
  },
  {
    q: "Quais planos têm integrações?",
    a: `O ${essencial.nome} não tem integrações. O ${profissional.nome} conecta ArcGIS Online, Google Sheets e Microsoft 365, e o ${corporativo.nome} acrescenta o ArcGIS Enterprise. Para outros sistemas, a implementação customizada custa ${brl(valorHora)} por hora, com mínimo de ${minimoHoras} horas.`,
  },
  {
    q: "A criptografia só existe no Corporativo?",
    a: `Não. Em todos os planos, as coletas ficam criptografadas no aparelho, na transmissão e no servidor. O ${corporativo.nome} acrescenta a opção de criptografar também o pacote offline do projeto no aparelho, com mapas e camadas.`,
  },
  {
    q: "Posso comprar mais armazenamento?",
    a: `Sim, em pacotes extras de ${EXTRAS.armazenamento.pacote}. Vamos publicar o preço do pacote em breve.`,
  },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const ofertasLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TerraNode",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Android, iOS, Web",
  offers: PLANOS.map((p) => ({
    "@type": "Offer",
    name: `Plano ${p.nome}`,
    description: `A partir de ${p.minimo} coletores, por mês`,
    price: p.preco.toFixed(2),
    priceCurrency: "BRL",
  })),
};

const participar = [
  "Deixe seu e-mail na lista",
  "Escolha: só o aviso do lançamento, ou o grupo de early testers",
  "Early testers usam antes e ajudam a definir o que entra primeiro",
];

const abre = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
const certo = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
const fora = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 12h10"/></svg>';
---
<Base title={title} description={description} rodapeTopo="#0C1312">
  <Animacoes />
  <div class="tn-rec tn-home">

    <div class="tn-rec-topo" data-rolagem-offset><Header /></div>

    <!-- Hero -->
    <section class="tn-rec-hero tn-home-hero tn-tema-claro tn-precos-hero">
      <div class="tn-rec-hero__texto" data-anim-bloco>
        <span class="tn-rec-pilula" data-anim="up">PREÇOS</span>
        <h1 class="tn-rec-h1" data-anim="words">Preço em reais, <span class="tn-rec-h1__apagado">sem surpresa com o câmbio.</span></h1>
        <p class="tn-rec-lead tn-rec-hero__lead" data-anim="blur">Todos os planos têm projetos, formulários e coletas ilimitados. O que muda é o armazenamento, os relatórios, a IA, as integrações e o prazo de suporte.</p>
      </div>
    </section>

    <!-- Planos -->
    <section id="planos" class="tn-rec-secao tn-tema-claro tn-precos-planos">
      <div class="tn-precos-escala" data-precos-escala data-anim="up" hidden>
        <div class="tn-precos-escala__equipe">
          <label for="tn-precos-equipe" class="tn-precos-escala__rotulo">Quantos coletores vão trabalhar em campo?</label>
          <div class="tn-precos-escala__numero">
            <input id="tn-precos-equipe" type="number" min="1" max="9999" step="1" inputmode="numeric" value={EQUIPE_INICIAL} data-precos-numero>
            <span>coletores</span>
          </div>
        </div>
        <div class="tn-precos-escala__regua">
          <div class="tn-precos-escala__barra" aria-hidden="true"></div>
          <input type="range" min={ESCALA.min} max={ESCALA.max} step="1" value={EQUIPE_INICIAL} aria-label="Número de coletores" data-precos-faixa>
          <div class="tn-precos-escala__marcas" aria-hidden="true">
            {ESCALA.marcas.map((m) => <span style={`--p: ${posicao(m)}`}>{m}</span>)}
          </div>
        </div>
      </div>
      <p class="tn-precos-sr" aria-live="polite" data-precos-status></p>

      <div class="tn-precos-grade" data-anim-group="up">
        {PLANOS.map((p) => (
          <article
            class:list={["tn-precos-plano", p.id === TESTE.plano && "tn-precos-plano--destaque tn-tema-escuro"]}
            data-plano={p.nome}
            data-preco={p.preco}
            data-minimo={p.minimo}
            data-extra={p.extra}
          >
            <div class="tn-precos-plano__topo">
              <div class="tn-precos-plano__nome-linha">
                <h2 class="tn-precos-plano__nome">{p.nome}</h2>
                {p.id === TESTE.plano && <span class="tn-precos-plano__selo">TESTE DE {TESTE.dias} DIAS</span>}
              </div>
              <p class="tn-precos-plano__resumo">{p.resumo}</p>
            </div>
            <div class="tn-precos-plano__preco">
              <span class="tn-rec-cap__rotulo" data-plano-coletores>{rotuloColetores(p.minimo, EQUIPE_INICIAL).toUpperCase()}</span>
              <p class="tn-precos-plano__valor"><span data-plano-total>{brl(totalMensal(p, EQUIPE_INICIAL))}</span><small>/mês</small></p>
              <p class="tn-precos-plano__regra">Mínimo de {p.minimo} coletores. Coletor extra: {brl(p.extra)}/mês.</p>
            </div>
            <a
              href={WAITLIST}
              target="_blank"
              rel="noopener"
              class:list={["tn-rec-btn", p.id === TESTE.plano && "tn-rec-btn--claro"]}
              data-mp-cta={`precos_plano_${p.id}`}
            >{p.id === "corporativo" ? "Falar com o time" : "Entrar na lista de espera"}</a>
            <div class="tn-precos-plano__itens">
              {p.herda && <p class="tn-precos-plano__herda">{p.herda}</p>}
              <ul class="tn-precos-lista">
                {p.inclui.map((item) => <li>{item}</li>)}
                {p.naoInclui?.map((item) => <li class="tn-precos-lista__fora">{item}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <!-- The trial borrows the Profissional plan, so it sits right under the cards. -->
      <div id="teste" class="tn-precos-teste tn-tema-pessego" data-anim="up">
        <div class="tn-precos-teste__texto">
          <h2 class="tn-rec-h2 tn-rec-h2--pequeno">Teste o {planoDoTeste.nome} por {TESTE.dias} dias</h2>
          <p class="tn-precos-teste__lead">Sua equipe usa os recursos do plano {planoDoTeste.nome}, com três limites:</p>
          <ul class="tn-precos-teste__limites">
            {TESTE.limites.map((l) => <li>{l}</li>)}
          </ul>
        </div>
        <a href={WAITLIST} target="_blank" rel="noopener" class="tn-rec-btn tn-rec-btn--claro" data-mp-cta="precos_teste">Entrar na lista de espera</a>
      </div>
    </section>

    <!-- Tabela -->
    <section id="comparar" class="tn-rec-secao tn-rec-secao--linha tn-tema-claro">
      <div class="tn-rec-head" data-anim-bloco>
        <span class="tn-rec-pilula" data-anim="up">PLANO A PLANO</span>
        <h2 class="tn-rec-h2" data-anim="words">O que cada plano inclui</h2>
      </div>
      <div class="tn-cmp-tabela__caixa tn-precos-tabela__caixa" data-anim="up">
        <table class="tn-cmp-tabela tn-precos-tabela">
          <thead>
            <tr>
              <th scope="col"><span class="tn-precos-sr">Recurso</span></th>
              {PLANOS.map((p) => <th scope="col" class={p.id === TESTE.plano ? "tn-cmp-tabela__tn" : undefined}>{p.nome}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="tn-precos-tabela__grupo"><th scope="rowgroup" colspan="4">Equipe e preço</th></tr>
            <tr>
              <th scope="row">Preço por mês</th>
              {PLANOS.map((p) => <td data-rotulo={p.nome} class={p.id === TESTE.plano ? "tn-cmp-tabela__tn" : undefined}>{brl(p.preco)}</td>)}
            </tr>
            <tr>
              <th scope="row">Mínimo de coletores</th>
              {PLANOS.map((p) => <td data-rotulo={p.nome} class={p.id === TESTE.plano ? "tn-cmp-tabela__tn" : undefined}>{p.minimo}</td>)}
            </tr>
            <tr>
              <th scope="row">Coletor extra, por mês</th>
              {PLANOS.map((p) => <td data-rotulo={p.nome} class={p.id === TESTE.plano ? "tn-cmp-tabela__tn" : undefined}>{brl(p.extra)}</td>)}
            </tr>
          </tbody>
          {COMPARACAO.map((g) => (
            <tbody>
              <tr class="tn-precos-tabela__grupo"><th scope="rowgroup" colspan="4">{g.grupo}</th></tr>
              {g.linhas.map((l) => (
                <tr>
                  <th scope="row">{l.nome}</th>
                  {l.valores.map((v, i) => (
                    <td data-rotulo={PLANOS[i].nome} class={PLANOS[i].id === TESTE.plano ? "tn-cmp-tabela__tn" : undefined}>
                      {v === true ? (
                        <span class="tn-precos-tabela__sim"><span set:html={certo} /><span class="tn-precos-sr">Incluído</span></span>
                      ) : v === false ? (
                        <span class="tn-precos-tabela__nao"><span set:html={fora} /><span class="tn-precos-sr">Não incluído</span></span>
                      ) : v}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </section>

    <!-- Além do plano -->
    <section id="extras" class="tn-rec-secao tn-tema-pessego">
      <div class="tn-rec-head" data-anim-bloco>
        <span class="tn-rec-pilula" data-anim="up">ALÉM DO PLANO</span>
        <h2 class="tn-rec-h2" data-anim="words">Mais espaço e integrações sob medida</h2>
      </div>
      <div class="tn-precos-extras" data-anim-group="up">
        <article class="tn-precos-extra">
          <h3 class="tn-precos-extra__nome">Pacote de armazenamento extra</h3>
          <p class="tn-precos-extra__valor">{EXTRAS.armazenamento.pacote}</p>
          <p class="tn-precos-extra__texto">Para guardar mais do que o seu plano inclui.</p>
          <span class="tn-rec-pilula">{EXTRAS.armazenamento.preco.toUpperCase()}</span>
        </article>
        <article class="tn-precos-extra">
          <h3 class="tn-precos-extra__nome">Implementação customizada e integrações sob medida</h3>
          <p class="tn-precos-extra__valor">{brl(valorHora)}<small>/hora</small></p>
          <p class="tn-precos-extra__texto">Para conectar o TerraNode a um sistema da sua operação. Mínimo de {minimoHoras} horas.</p>
          <a href={WAITLIST} target="_blank" rel="noopener" class="tn-rec-btn" data-mp-cta="precos_implementacao">Falar com o time</a>
        </article>
      </div>
    </section>

    <!-- Perguntas -->
    <section id="perguntas" class="tn-rec-secao tn-tema-claro">
      <div class="tn-rec-head" data-anim-bloco>
        <span class="tn-rec-pilula" data-anim="up">PERGUNTAS FREQUENTES</span>
        <h2 class="tn-rec-h2 tn-rec-h2--pequeno" data-anim="words">Antes de escolher um plano</h2>
      </div>
      <div class="tn-home-perguntas__lista tn-precos-perguntas" data-anim-group="up">
        {faq.map((f, i) => (
          <details class="tn-home-pergunta" open={i === 0}>
            <summary>{f.q}<span class="tn-home-pergunta__icone" set:html={abre} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Fechamento -->
    <!-- Dark, so the page runs into the dark footer without a seam. -->
    <section class="tn-rec-secao tn-rec-secao--curta tn-tema-escuro tn-sobre-fechamento">
      <div class="tn-rec-cta" data-anim="up" data-anim-bloco>
        <div class="tn-rec-cta__texto">
          <span class="tn-rec-cap__rotulo">LANÇAMENTO EM BREVE</span>
          <h2 class="tn-rec-h2 tn-rec-h2--pequeno" data-anim="words">Leve sua próxima campanha de campo para o TerraNode</h2>
          <p class="tn-rec-lead" data-anim="blur">Entre na lista para ser avisado, ou candidate-se a early tester e ajude a definir o que entra primeiro.</p>
          <div class="tn-rec-acoes tn-rec-acoes--esquerda">
            <a href={WAITLIST} target="_blank" rel="noopener" class="tn-rec-btn tn-rec-btn--claro" data-mp-cta="precos_fechamento">Entrar na lista de espera</a>
            <a href={WAITLIST} target="_blank" rel="noopener" class="tn-rec-btn" data-mp-cta="precos_fechamento_falar_com_time">Falar com o time</a>
          </div>
        </div>
        <ol class="tn-rec-passos" data-anim-group="left">
          {participar.map((p, i) => <li><span class="tn-rec-passos__num">{i + 1}</span>{p}</li>)}
        </ol>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(ofertasLd)} />
</Base>

<script>
  import { brl, rotuloColetores, totalMensal } from "../lib/planos";

  // The calculator. The slider covers the usual range and the number field takes any
  // number of collectors; each keeps the other in step, and every card recomputes its total.
  const raiz = document.querySelector<HTMLElement>("[data-precos-escala]");
  const numero = raiz?.querySelector<HTMLInputElement>("[data-precos-numero]");
  const faixa = raiz?.querySelector<HTMLInputElement>("[data-precos-faixa]");
  const status = document.querySelector<HTMLElement>("[data-precos-status]");

  if (raiz && numero && faixa) {
    raiz.hidden = false;
    const cartoes = [...document.querySelectorAll<HTMLElement>("[data-plano]")].map((el) => ({
      nome: el.dataset.plano!,
      plano: { preco: Number(el.dataset.preco), minimo: Number(el.dataset.minimo), extra: Number(el.dataset.extra) },
      total: el.querySelector<HTMLElement>("[data-plano-total]")!,
      coletores: el.querySelector<HTMLElement>("[data-plano-coletores]")!,
    }));
    const limite = (v: number) => Math.min(Math.max(Math.round(v), Number(numero.min)), Number(numero.max));

    let atual = limite(Number(numero.value));
    const atualiza = (coletores: number) => {
      atual = coletores;
      faixa.value = String(coletores);
      for (const c of cartoes) {
        c.total.textContent = brl(totalMensal(c.plano, coletores));
        c.coletores.textContent = rotuloColetores(c.plano.minimo, coletores).toUpperCase();
      }
      if (status) status.textContent = cartoes.map((c) => `${c.nome}: ${brl(totalMensal(c.plano, coletores))} por mês`).join(". ");
    };

    faixa.addEventListener("input", () => {
      numero.value = faixa.value;
      atualiza(Number(faixa.value));
    });
    numero.addEventListener("input", () => {
      // Mid-edit the field can be empty: keep the last total until there's a number.
      if (numero.value !== "" && Number(numero.value) >= 1) atualiza(limite(Number(numero.value)));
    });
    numero.addEventListener("blur", () => { numero.value = String(atual); });

    // Browsers restore form values on reload, so read the field rather than assume 5.
    atualiza(atual);
    numero.value = String(atual);
  }
</script>
