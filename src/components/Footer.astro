---
import { asset } from "../lib/asset";
---
<div class="tn-section tn-section--dark tn-footer">
  <div class="tn-section__inner tn-footer__inner">
    <div class="tn-footer__top">
      <div class="tn-footer__brand">
        <div class="tn-footer__brand-row">
          <img src={asset("/terranode-logo.svg")} alt="TerraNode" class="tn-footer__logo">
        </div>
        <span class="tn-footer__brand-desc">Coleta de dados geoespaciais em campo, offline-first. Em breve.</span>
      </div>
      <div class="tn-footer__cols">
        <div class="tn-footer__col">
          <span class="tn-footer__col-title">Produto</span>
          <a href="#como-funciona" class="tn-footer__link">Como funciona</a>
          <a href="#o-app" class="tn-footer__link">O app</a>
          <a href="https://form.typeform.com/to/ZVQYTFV5" target="_blank" rel="noopener" data-mp-cta="footer_waitlist" class="tn-footer__link">Lista de espera</a>
        </div>
        <div class="tn-footer__col">
          <span class="tn-footer__col-title">Empresa</span>
          <a href="#faq" class="tn-footer__link">Perguntas frequentes</a>
          <a href="https://form.typeform.com/to/ZVQYTFV5" target="_blank" rel="noopener" data-mp-cta="footer_contact" class="tn-footer__link">Falar com o time</a>
        </div>
      </div>
    </div>
    <div class="tn-footer__bottom">
      <span class="tn-footer__copyright">© 2026 TerraNode. Feito no Brasil.</span>
      <span class="tn-footer__tagline">Feito com quem trabalha em campo.</span>
    </div>
  </div>
</div>
