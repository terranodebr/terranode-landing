---
import { Image } from "astro:assets";
import webReview from "../assets/web-review.png";
import mobileMap from "../assets/mobile-map.png";
import { icone, passosTerranode, type Passo } from "../lib/fluxo";

// Side-by-side illustration of the same survey done in each tool. Drawn in HTML
// rather than as an image so the copy stays editable in frontmatter and the steps
// reflow into one column on phones. No third-party screenshots or logos on purpose:
// the competitor side is described, the TerraNode side is shown with real screens.

interface Props {
  /** Column heading for the competitor, with its article: "Com o Fulcrum". */
  titulo: string;
  passos: Passo[];
}

const { titulo, passos } = Astro.props;

---
<div class="tn-section tn-section--white tn-section--border-top">
  <div class="tn-section__inner tn-dores">
    <div class="tn-dores__head">
      <span class="tn-eyebrow">O FLUXO</span>
      <h2 class="tn-h2">Do formulário ao dado validado</h2>
      <p class="tn-lead">O mesmo levantamento, feito nas duas ferramentas. Os passos de cada lado estão simplificados.</p>
    </div>

    <div class="tn-fluxo">
      <div class="tn-fluxo__col">
        <span class="tn-fluxo__head">{titulo}</span>
        <ol class="tn-fluxo__steps">
          {passos.map((p, i) => (
            <li class="tn-fluxo__step">
              <span class="tn-fluxo__icon" set:html={icone(p.icone)} />
              <div class="tn-fluxo__text">
                <span class="tn-fluxo__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="tn-fluxo__title">{p.titulo}</span>
                <span class="tn-fluxo__detail">{p.detalhe}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="tn-fluxo__col tn-fluxo__col--tn">
        <span class="tn-fluxo__head">Com o TerraNode</span>
        <ol class="tn-fluxo__steps">
          {passosTerranode.map((p, i) => (
            <li class="tn-fluxo__step">
              <span class="tn-fluxo__icon" set:html={icone(p.icone)} />
              <div class="tn-fluxo__text">
                <span class="tn-fluxo__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="tn-fluxo__title">{p.titulo}</span>
                <span class="tn-fluxo__detail">{p.detalhe}</span>
                {p.volta && (
                  <span class="tn-fluxo__volta">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
                    {p.volta}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="tn-fluxo__shots">
      <figure class="tn-fluxo__shot tn-fluxo__shot--web">
        <Image src={webReview} alt="Painel web do TerraNode: fila de revisão de pontos, com as respostas ao lado do mapa" widths={[560, 1120]} sizes="(max-width: 900px) 100vw, 720px" />
        <figcaption>Painel web · revisão de pontos</figcaption>
      </figure>
      <figure class="tn-fluxo__shot tn-fluxo__shot--phone">
        <Image src={mobileMap} alt="App do TerraNode: mapa de coleta com pontos, linhas e polígonos" widths={[280, 560]} sizes="280px" />
        <figcaption>App de campo · mapa de coleta</figcaption>
      </figure>
    </div>
  </div>
</div>
