---
// Data-driven for the same reason as Faq.astro: the home page and every sector page
// under /solucoes/ mount this component, and the tab/carousel JS below must stay in
// one place. Only the text layer is a prop — the four panel visuals are product UI
// mockups, identical for every sector, so they are selected by position.
import Visual01 from "./steps/Visual01.astro";
import Visual02 from "./steps/Visual02.astro";
import Visual03 from "./steps/Visual03.astro";
import Visual04 from "./steps/Visual04.astro";

export interface StepItem {
  /** Timeline label, upper case. */
  label: string;
  titulo: string;
  texto: string;
  /** "O que acontece aqui" bullets. Omitted on pages that don't detail the step. */
  lista?: string[];
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  items?: StepItem[];
}

const defaultItems: StepItem[] = [
  {
    label: "MONTAR FORMULÁRIO",
    titulo: "Monte o formulário",
    texto:
      "Arraste os campos, defina regras de obrigatoriedade e publique a versão que vai para o campo. Ou descreva o levantamento e deixe a IA montar o formulário.",
    lista: [
      "Campos de texto, número, foto, áudio e geometria",
      "Regras de validação e campos obrigatórios",
      "Versões publicadas com histórico de alterações",
      "Geração assistida por IA a partir de uma descrição",
    ],
  },
  {
    label: "MONTAR O TIME",
    titulo: "Monte o time",
    texto:
      "Convide coletores e revisores, defina permissões e atribua cada formulário a quem vai preencher em campo.",
    lista: [
      "Convite por e-mail ou link do projeto",
      "Perfis de coletor, revisor e gestor",
      "Formulários atribuídos pessoa por pessoa",
      "Produção individual acompanhada em tempo real",
    ],
  },
  {
    label: "COLETAR EM CAMPO",
    titulo: "Colete em campo",
    texto:
      "A equipe registra pontos com foto, áudio e geometria pelo aplicativo. Com ou sem sinal, o dado nunca se perde.",
    lista: [
      "Funciona 100% offline, no modo avião",
      "Precisão centimétrica com GNSS externo",
      "Fotos, áudios e croquis anexados ao ponto",
      "Sincronização automática quando o sinal volta",
    ],
  },
  {
    label: "REVISAR E VALIDAR",
    titulo: "Revise e valide",
    texto:
      "Cada ponto entra na fila de revisão. Valide, rejeite com comentário e exporte só o dado confiável.",
    lista: [
      "Fila de revisão organizada por projeto",
      "Validar ou rejeitar com comentário do revisor",
      "Retorno direto ao coletor para correção",
      "Exportação em CSV, GeoJSON e Shapefile",
    ],
  },
];

const {
  id = "como-funciona",
  eyebrow = "COMO FUNCIONA",
  title = "Quatro passos entre o planejamento e o dado validado",
  lead = "Do desenho do formulário à exportação, tudo acontece em um único fluxo. Sem planilhas paralelas, sem redigitação, sem dado perdido no caminho.",
  items = defaultItems,
} = Astro.props;

const visuals = [Visual01, Visual02, Visual03, Visual04];
const pad = (n: number) => String(n).padStart(2, "0");
---
<div class="tn-section tn-section--white tn-section--border-top tn-steps" id={id} data-steps-root>

  <div class="tn-steps__head">
    <div class="tn-steps__eyebrow-row">
      <span class="tn-eyebrow">{eyebrow}</span>
      <div class="tn-steps__rule"></div>
    </div>
    <div class="tn-steps__head-grid">
      <h2 class="tn-h2 tn-steps__h2">{title}</h2>
      <p class="tn-lead tn-steps__lead">{lead}</p>
    </div>

    <div class="tn-steps__timeline" role="tablist" aria-label="Etapas do TerraNode">
      <div class="tn-steps__timeline-rail"></div>
      {items.map((item, i) => (
        <button
          class:list={["tn-steps__stop", i === 0 && "is-active"]}
          type="button"
          role="tab"
          data-step={i}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`tn-steps-card-${i}`}
        >
          <span class="tn-steps__stop-label">{item.label}</span>
          <span class="tn-steps__stop-chip"><span class="tn-steps__stop-num">{pad(i + 1)}</span></span>
        </button>
      ))}
    </div>
  </div>

  <div class="tn-steps__viewport">
    <div class="tn-steps__track">
      {items.map((item, i) => {
        const Visual = visuals[i];
        return (
          <div class="tn-steps__card-slide" id={`tn-steps-card-${i}`} role="tabpanel" data-step={i}>
            <div class="tn-steps__panel-text">
              <span class="tn-steps__panel-step">PASSO {pad(i + 1)}</span>
              <h3 class="tn-steps__panel-title">{item.titulo}</h3>
              <p class="tn-steps__panel-desc">{item.texto}</p>
              {item.lista && item.lista.length > 0 && (
                <div class="tn-steps__panel-list">
                  <span class="tn-steps__panel-list-label">O que acontece aqui</span>
                  <ul class="tn-steps__list">
                    {item.lista.map((entry) => (
                      <li><span class="tn-steps__list-dot"></span>{entry}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            {Visual && <Visual />}
          </div>
        );
      })}
    </div>
  </div>

  <div class="tn-steps__controls">
    <button class="tn-steps__nav-btn" type="button" data-steps-prev aria-label="Passo anterior">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 18L8 12L14 6L15.4 7.4L10.8 12L15.4 16.6L14 18Z" fill="#16201F"></path></svg>
    </button>
    <button class="tn-steps__nav-btn" type="button" data-steps-next aria-label="Próximo passo">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M10 18L8.6 16.6L13.2 12L8.6 7.4L10 6L16 12L10 18Z" fill="#16201F"></path></svg>
    </button>
    <span class="tn-steps__counter" data-steps-counter>01 / {pad(items.length)}</span>
  </div>

</div>

<script is:inline>
(function () {
  // Step carousel. Like the use-case rows, nothing here caches element references:
  // this platform's renderer periodically re-syncs the DOM against the compiled
  // template, so clicks are delegated on document and a ticker re-paints whenever
  // the renderer has wiped our state (detected via the data-steps-painted marker).
  var GAP = 24;

  // One entry per [data-steps-root] on the page, keyed by index: a sector page mounts
  // this component alongside the one on the home page only in theory, but keying the
  // state per root keeps two instances from fighting over a single `active`.
  var state = [];

  function roots() { return Array.prototype.slice.call(document.querySelectorAll('[data-steps-root]')); }
  function indexOfRoot(el) { return roots().indexOf(el); }
  function activeOf(el) {
    var i = indexOfRoot(el);
    return i < 0 ? 0 : (state[i] || 0);
  }
  function setActive(el, value) {
    var i = indexOfRoot(el);
    if (i >= 0) state[i] = value;
  }
  function slidesOf(el) { return Array.prototype.slice.call(el.querySelectorAll('.tn-steps__card-slide')); }

  function render(el) {
    var slides = slidesOf(el);
    if (!slides.length) return;
    var active = Math.max(0, Math.min(slides.length - 1, activeOf(el)));
    setActive(el, active);

    var track = el.querySelector('.tn-steps__track');
    var width = slides[0].getBoundingClientRect().width;
    if (track && width) {
      track.style.transform = 'translateX(' + -((width + GAP) * active + width / 2) + 'px)';
    }

    slides.forEach(function (slide, i) {
      slide.classList.toggle('is-active', i === active);
    });
    el.querySelectorAll('.tn-steps__stop').forEach(function (stop, i) {
      var on = i === active;
      stop.classList.toggle('is-active', on);
      stop.setAttribute('aria-selected', on ? 'true' : 'false');
    });

    var counter = el.querySelector('[data-steps-counter]');
    if (counter) counter.textContent = '0' + (active + 1) + ' / 0' + slides.length;

    var prev = el.querySelector('[data-steps-prev]');
    var next = el.querySelector('[data-steps-next]');
    if (prev) prev.disabled = active === 0;
    if (next) next.disabled = active === slides.length - 1;

    // Only meaningful once the track has a measurable width; until then the ticker
    // keeps retrying because the marker stays unset.
    if (width) el.setAttribute('data-steps-painted', String(active));
  }

  function go(el, i) {
    setActive(el, i);
    render(el);
  }

  document.addEventListener('click', function (e) {
    if (!e.target.closest) return;
    var el = e.target.closest('[data-steps-root]');
    if (!el) return;

    var stop = e.target.closest('.tn-steps__stop');
    if (stop) return go(el, Array.prototype.slice.call(el.querySelectorAll('.tn-steps__stop')).indexOf(stop));
    if (e.target.closest('[data-steps-prev]')) return go(el, activeOf(el) - 1);
    if (e.target.closest('[data-steps-next]')) return go(el, activeOf(el) + 1);
  });

  setInterval(function () {
    roots().forEach(function (el) {
      if (el.getAttribute('data-steps-painted') !== String(activeOf(el))) render(el);
    });
  }, 200);

  // Card width is viewport-relative, so the centring offset has to be recomputed.
  window.addEventListener('resize', function () {
    roots().forEach(function (el) { el.removeAttribute('data-steps-painted'); });
  });
})();
</script>
