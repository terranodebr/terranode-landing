---
// Body of /recursos/catalogos/, between the shared hero and closing CTA
// (src/layouts/Recurso.astro): the import bento, the styling scroll story, the four
// style types and the public catalogs over the dotted map.
import Estilo from "./Estilo.astro";
import Raster from "./Raster.astro";
import Bento from "./Bento.astro";
import IaCard from "./IaCard.astro";
import MapaPontilhado from "./MapaPontilhado.astro";
import Historia, { type Capitulo } from "./Historia.astro";
import type { Recurso } from "../../lib/recursos";

interface Props {
  entry: Recurso;
}

const d = Astro.props.entry.data;

const [importar, estilo, rasters] = d.secoes;
const semPonto = (s: string) => s.replace(/\.$/, "");

// Bento: the import items after the drag-and-drop one, each with its sketch.
const bento = importar.itens.slice(1, 5).map((item, i) => ({
  ...item,
  visual: (["camadas", "progresso", "cog", "arcgis"] as const)[i],
}));
// The first import item lists the formats (shown as the marquee) and then the cloud
// sources (kept in the lead), one sentence each.
const [, nuvem] = importar.itens[0].texto.split(/(?<=\.) /);
const formatos = [
  "Shapefile", "GeoPackage", "GeoJSON", "FlatGeobuf", "File Geodatabase", "MapInfo",
  "CSV com coordenadas", "GeoTIFF", "IMG", "VRT",
];

// Scroll story: one chapter per styling capability.
const porTitulo = (itens: typeof estilo.itens, prefixo: string) =>
  itens.find((i) => i.titulo.startsWith(prefixo))!;
const valoresReais = porTitulo(estilo.itens, "Categorias");
const primeiraAbertura = rasters.itens[0];
const capitulos: Capitulo[] = [
  {
    rotulo: estilo.eyebrow,
    titulo: semPonto(valoresReais.titulo),
    marca: "valores reais",
    texto: valoresReais.texto,
    itens: estilo.itens.filter(
      (i) => i !== valoresReais && !i.titulo.startsWith("Estilize") && !i.titulo.startsWith("Quatro"),
    ),
    visual: Estilo,
  },
  {
    id: rasters.id,
    rotulo: rasters.eyebrow,
    titulo: semPonto(primeiraAbertura.titulo),
    marca: "primeira abertura",
    texto: primeiraAbertura.texto,
    itens: rasters.itens.slice(1),
    visual: Raster,
  },
  ...(d.destaque
    ? [{
        id: d.destaque.id,
        rotulo: d.destaque.eyebrow,
        titulo: d.destaque.titulo,
        marca: "IA",
        texto: d.destaque.texto,
        itens: (d.destaque.video?.capitulos ?? []).map((c) => ({ titulo: c.titulo, texto: c.texto })),
        nota: d.destaque.nota,
        visual: IaCard,
      }]
    : []),
];

// "Quatro tipos de estilo": names come from the copy, the legends are drawn.
const quatro = porTitulo(estilo.itens, "Quatro");
const tipos = [
  { nome: "Símbolo único", legenda: "unico" },
  { nome: "Categorias por valor", legenda: "categorias" },
  { nome: "Classes graduadas", legenda: "graduado" },
  { nome: "Rampas contínuas", legenda: "rampa" },
];
---
<!-- Importação: bento 2×2 + faixa de formatos -->
<section id={importar.id} class="tn-rec-secao">
  <div class="tn-rec-head" data-anim-bloco>
    <span class="tn-rec-pilula" data-anim="up">{importar.eyebrow}</span>
    <h2 class="tn-rec-h2" data-anim="words">{importar.titulo}</h2>
    <p class="tn-rec-lead" data-anim="blur">{importar.itens[0].titulo} {nuvem}</p>
  </div>

  <div class="tn-rec-bento">
    {bento.map((b) => (
      <div class="tn-rec-bento__celula" data-anim="up" data-anim-bloco>
        <div class="tn-rec-bento__visual"><Bento tipo={b.visual} /></div>
        <span class="tn-rec-bento__rotulo" data-anim="up">{semPonto(b.titulo)}</span>
        <p class="tn-rec-bento__texto" data-anim="blur">{b.texto}</p>
      </div>
    ))}
  </div>

  <div class="tn-rec-formatos" data-anim="blur">
  <span class="tn-rec-faixa__legenda">Formatos aceitos, compactados ou não</span>
  <div class="tn-rec-faixa" aria-label={`Formatos aceitos: ${formatos.join(", ")}`}>
    <div class="tn-rec-faixa__trilho">
      {[0, 1].map((copia) => (
        <div class="tn-rec-faixa__grupo" aria-hidden={copia === 1 ? "true" : undefined}>
          {formatos.map((f) => <span class="tn-rec-faixa__item">{f}</span>)}
        </div>
      ))}
    </div>
  </div>
  </div>
</section>

<!-- Estilo: história com o visual fixo -->
<section id={estilo.id} class="tn-rec-secao tn-rec-secao--linha">
  <div class="tn-rec-head" data-anim-bloco>
    <span class="tn-rec-pilula" data-anim="up">{estilo.eyebrow}</span>
    <h2 class="tn-rec-h2" data-anim="words">{estilo.titulo}</h2>
    <p class="tn-rec-lead" data-anim="blur">{estilo.itens[0].titulo} {estilo.itens[0].texto}</p>
  </div>
  <Historia capitulos={capitulos} />
</section>

<!-- Quatro tipos de estilo -->
<section class="tn-rec-secao tn-rec-secao--curta">
  <div class="tn-rec-head tn-rec-head--pequeno" data-anim-bloco>
    <h2 class="tn-rec-h2 tn-rec-h2--pequeno" data-anim="words">{semPonto(quatro.titulo)}</h2>
    <p class="tn-rec-lead" data-anim="blur">{quatro.texto}</p>
  </div>
  <div class="tn-rec-tipos">
    {tipos.map((t, i) => (
      <div class="tn-rec-tipo" data-anim="up" data-anim-bloco>
        <span class="tn-rec-tipo__num">{String(i + 1).padStart(2, "0")}</span>
        <span class="tn-rec-tipo__nome">{t.nome}</span>
        <div class={`tn-rec-legenda tn-rec-legenda--${t.legenda}`} aria-hidden="true">
          {t.legenda === "unico" && <span class="tn-rec-legenda__sw" data-anim="pop"></span>}
          {t.legenda === "categorias" && [0, 1, 2, 3, 4].map(() => <span class="tn-rec-legenda__sw" data-anim="pop"></span>)}
          {t.legenda === "graduado" && (
            <>
              <div class="tn-rec-legenda__classes" data-anim-group="grow">{[0, 1, 2, 3, 4].map(() => <span></span>)}</div>
              <div class="tn-rec-legenda__metodos" data-anim-group="up"><span>Intervalos iguais</span><span>Quantis</span><span>Quebras naturais</span></div>
            </>
          )}
          {t.legenda === "rampa" && <span class="tn-rec-legenda__rampa" data-anim="wipe"></span>}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Catálogos públicos -->
{d.complemento && (
  <section class="tn-rec-secao tn-rec-publicos">
    <div class="tn-rec-publicos__mapa" data-anim-bloco><MapaPontilhado /></div>
    <div class="tn-rec-head tn-rec-publicos__head" data-anim-bloco>
      <span class="tn-rec-pilula" data-anim="up">{d.complemento.eyebrow}</span>
      <h2 class="tn-rec-h2" data-anim="words">{d.complemento.titulo}</h2>
      <p class="tn-rec-lead" data-anim="blur">{d.complemento.texto}</p>
      <div class="tn-rec-publicos__pilulas" data-anim-group="pop">
        <span>Mapas base</span>
        <span>Limites oficiais</span>
      </div>
    </div>
  </section>
)}
