---
// The builder's preview, as the recording shows it: the form laid out the way the field
// app renders it, in a phone frame. Coordinates are the ones in the recording.
---
<div class="tn-form-cel" role="img" aria-label="Pré-visualização do Formulário de Inspeção no aplicativo de campo: localização capturada, data e hora do registro, gravação de áudio, assinatura e o botão Salvar ponto.">
  <div class="tn-form-cel__tela">
    <span class="tn-form-cel__ilha"></span>
    <span class="tn-form-cel__titulo">Formulário de Inspeção</span>
    <div class="tn-form-cel__campos" data-anim-group="up">
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Geometria</span>
        <span class="tn-form-cel__rotulo">Área de intervenção</span>
        <dl class="tn-form-cel__coords">
          <dt>Latitude</dt><dd>-27.589061°</dd>
          <dt>Longitude</dt><dd>-48.504395°</dd>
          <dt>Precisão</dt><dd>± 3 m</dd>
        </dl>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Data</span>
        <span class="tn-form-cel__rotulo">Data e hora do registro</span>
        <div class="tn-form-cel__data"><span>dd/mm/aaaa</span><span>hh:mm</span></div>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Mídia</span>
        <span class="tn-form-cel__rotulo">Observação por áudio</span>
        <span class="tn-form-cel__acao">Gravar áudio</span>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Mídia</span>
        <span class="tn-form-cel__rotulo">Assinatura do responsável</span>
        <span class="tn-form-cel__acao">Assinar</span>
      </div>
    </div>
    <span class="tn-form-cel__salvar" data-anim="up">Salvar ponto</span>
  </div>
</div>
