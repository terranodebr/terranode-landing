---
// The builder's preview, as the recording shows it: the form laid out the way the field
// app renders it, on a phone drawn to real proportions (iPhone 15, 71.6 × 147.6 mm).
// Coordinates are the ones in the recording.

const sinal = '<svg width="13" height="8" viewBox="0 0 17 11" fill="currentColor" aria-hidden="true"><rect x="0" y="7" width="3" height="4" rx="0.8"/><rect x="4.5" y="5" width="3" height="6" rx="0.8"/><rect x="9" y="2.5" width="3" height="8.5" rx="0.8"/><rect x="13.5" y="0" width="3" height="11" rx="0.8"/></svg>';
const wifi = '<svg width="11" height="8" viewBox="0 0 16 11" fill="currentColor" aria-hidden="true"><path d="M8 2.2c2.3 0 4.4.9 6 2.4l1.1-1.2A10.2 10.2 0 0 0 8 .6 10.2 10.2 0 0 0 .9 3.4L2 4.6a8.6 8.6 0 0 1 6-2.4zm0 3.3c1.4 0 2.7.5 3.7 1.4l1.1-1.2A7.1 7.1 0 0 0 8 3.9a7.1 7.1 0 0 0-4.8 1.8l1.1 1.2c1-.9 2.3-1.4 3.7-1.4zM8 8.8 10.1 6.5a3.4 3.4 0 0 0-4.2 0z"/></svg>';
const bateria = '<svg width="18" height="8" viewBox="0 0 25 12" fill="none" aria-hidden="true"><rect x="0.5" y="0.5" width="21" height="11" rx="3.2" stroke="currentColor" opacity="0.4"/><rect x="2" y="2" width="16" height="8" rx="2" fill="currentColor"/><path d="M23 4v4c.8-.3 1.3-1.1 1.3-2S23.8 4.3 23 4z" fill="currentColor" opacity="0.45"/></svg>';
const voltar = '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>';
const calendario = '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>';
const microfone = '<svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="8.5" y="2.5" width="7" height="12" rx="3.5"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 17.5V21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
const camera = '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l1.5-2.5h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.2"/></svg>';
const caneta = '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20c3-1 4.5-4 7-4s1.5 3 4 3 3-2 5-2"/><path d="m14.5 4.5 3 3L9 16l-4 1 1-4z"/></svg>';
---
<div class="tn-form-cel" role="img" aria-label="Pré-visualização do Formulário de Inspeção no aplicativo de campo: localização capturada, data e hora do registro, gravação de áudio, assinatura, fotos e o botão Salvar ponto.">
  <div class="tn-form-cel__tela">
    <div class="tn-form-cel__status">
      <span class="tn-form-cel__hora">9:41</span>
      <span class="tn-form-cel__ilha"></span>
      <span class="tn-form-cel__icones"><span set:html={sinal} /><span set:html={wifi} /><span set:html={bateria} /></span>
    </div>
    <div class="tn-form-cel__barra">
      <span class="tn-form-cel__voltar" set:html={voltar} />
      <span class="tn-form-cel__titulo">Formulário de Inspeção</span>
    </div>
    <div class="tn-form-cel__campos" data-anim-group="up">
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Geometria</span>
        <span class="tn-form-cel__rotulo">Área de intervenção</span>
        <dl class="tn-form-cel__coords">
          <dt>Latitude</dt><dd>-27.589061°</dd>
          <dt>Longitude</dt><dd>-48.504395°</dd>
          <dt>Precisão</dt><dd>± 3 m</dd>
        </dl>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Data</span>
        <span class="tn-form-cel__rotulo">Data e hora do registro</span>
        <div class="tn-form-cel__data"><span>dd/mm/aaaa</span><span>hh:mm<span set:html={calendario} /></span></div>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Mídia</span>
        <span class="tn-form-cel__rotulo">Observação por áudio</span>
        <span class="tn-form-cel__acao"><span set:html={microfone} />Gravar áudio</span>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Mídia</span>
        <span class="tn-form-cel__rotulo">Assinatura do responsável</span>
        <span class="tn-form-cel__acao"><span set:html={caneta} />Assinar</span>
      </div>
      <div class="tn-form-cel__campo">
        <span class="tn-form-cel__grupo">Mídia</span>
        <span class="tn-form-cel__rotulo">Fotos da estrutura</span>
        <div class="tn-form-cel__fotos"><span class="tn-form-cel__miniatura"></span><span class="tn-form-cel__acao"><span set:html={camera} />Tirar foto</span></div>
      </div>
    </div>
    <div class="tn-form-cel__rodape">
      <span class="tn-form-cel__salvar" data-anim="up">Salvar ponto</span>
      <span class="tn-form-cel__home"></span>
    </div>
  </div>
</div>
