---
// Small dark UI sketches for the home, in the feature pages' style (see
// recursos/Bento.astro). Ids, names and counts are illustrative; the states they show
// are the product's.

interface Props {
  tipo: "formulario" | "time" | "coleta" | "revisao";
}

const { tipo } = Astro.props;

const ok = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
const gira = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true" class="tn-cat-gira"><path d="M12 3a9 9 0 1 0 9 9"/></svg>';
const mais = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
const semSinal = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 8.8a15 15 0 0 1 4.2-2.6M9.5 5.2A15 15 0 0 1 22 8.8M5 12.5a10 10 0 0 1 3-1.9M13.3 10.3A10 10 0 0 1 19 12.5M8.5 16a5 5 0 0 1 7 0M12 20h.01M3 3l18 18"/></svg>';

const fila = [
  { id: "PT-0339", texto: "3 fotos enviadas", estado: "ok" },
  { id: "PT-0340", texto: "enviando áudio…", estado: "andamento" },
  { id: "PT-0341", texto: "geometria + 2 fotos", estado: "espera" },
];

const campos = [
  { nome: "Número da torre", tipo: "texto", meta: "obrigatório" },
  { nome: "Fotos da estrutura", tipo: "foto", meta: "mín. 3" },
  { nome: "Área de intervenção", tipo: "geometria", meta: "polígono" },
];

const pessoas = [
  { sigla: "MR", nome: "Marina Reis", papel: "Coletora · campo", meta: "3 formulários" },
  { sigla: "JC", nome: "Joel Camargo", papel: "Coletor · campo", meta: "2 formulários" },
  { sigla: "AL", nome: "Ana Lobo", papel: "Revisora", meta: "fila de revisão" },
];
---
{tipo === "formulario" && (
  <div class="tn-rec-mini tn-home-largo" aria-hidden="true">
    <div class="tn-rec-mini__arquivo" data-anim="up">
      <span class="tn-rec-mini__ext">v3</span>
      Inspeção de torres
      <span class="tn-rec-mini__meta">publicado</span>
    </div>
    <ul class="tn-rec-mini__lista" data-anim-group="left">
      {campos.map((c) => (
        <li class="tn-rec-mini__linha">
          <span class={`tn-rec-mini__geo tn-rec-mini__geo--${c.tipo === "geometria" ? "poly" : c.tipo === "foto" ? "ponto" : "linha"}`}></span>
          <span class="tn-home-campo">{c.nome}</span>
          <span class="tn-rec-mini__meta">{c.meta}</span>
        </li>
      ))}
      <li class="tn-rec-mini__linha tn-home-tracejado"><span class="tn-home-mais" set:html={mais} />Adicionar campo</li>
    </ul>
    <div class="tn-home-ia" data-anim="up">
      <span class="tn-home-ia__brilho">✦</span>
      “Vistoria de torres com fotos e severidade”
    </div>
  </div>
)}

{tipo === "time" && (
  <div class="tn-rec-mini tn-home-largo" aria-hidden="true">
    <ul class="tn-rec-mini__lista" data-anim-group="left">
      {pessoas.map((p, i) => (
        <li class="tn-rec-mini__linha">
          <span class={`tn-home-avatar tn-home-avatar--${i}`}>{p.sigla}</span>
          <span class="tn-home-pessoa">
            <span>{p.nome}</span>
            <span class="tn-home-pessoa__papel">{p.papel}</span>
          </span>
          <span class="tn-rec-mini__meta">{p.meta}</span>
        </li>
      ))}
      <li class="tn-rec-mini__linha tn-home-tracejado"><span class="tn-home-mais" set:html={mais} />Convidar por e-mail</li>
    </ul>
  </div>
)}

{tipo === "coleta" && (
  <div class="tn-rec-mini tn-home-largo" aria-hidden="true">
    <div class="tn-home-offline" data-anim="up">
      <span class="tn-home-sinal" set:html={semSinal} />
      Sem sinal · salvando localmente
    </div>
    <div class="tn-home-ponto" data-anim="up">
      <div class="tn-home-ponto__topo">
        <span class="tn-home-mono">PT-0341</span>
        <span class="tn-home-gps"><span></span>GPS ±3 cm</span>
      </div>
      <svg viewBox="0 0 260 90" class="tn-home-ponto__mapa">
        <path d="M24 70 L90 26 L160 48 L236 18" class="tn-home-geo__linha" />
        {[[24, 70], [90, 26], [160, 48], [236, 18]].map(([x, y]) => <circle cx={x} cy={y} r="4" class="tn-home-geo__vertice" />)}
      </svg>
      <div class="tn-home-ponto__anexos" data-anim-group="pop">
        <span>Foto</span><span>Foto</span><span>Áudio</span><span>Croqui</span>
      </div>
      <span class="tn-home-ponto__salvar">Salvar ponto</span>
    </div>
  </div>
)}

{tipo === "revisao" && (
  <div class="tn-rec-mini tn-home-largo" aria-hidden="true">
    <ul class="tn-rec-mini__lista" data-anim-group="left">
      <li class="tn-rec-mini__linha">
        <span class="tn-home-mono">PT-0339</span>
        <span class="tn-home-status tn-home-status--ok"><span set:html={ok} />Validado</span>
      </li>
      <li class="tn-home-revisao">
        <div class="tn-home-revisao__topo">
          <span class="tn-home-mono">PT-0340</span>
          <span class="tn-home-status">Em revisão</span>
        </div>
        <p>“Falta a foto do isolador.”</p>
        <div class="tn-home-revisao__acoes">
          <span>Rejeitar</span>
          <span class="tn-home-revisao__validar">Validar</span>
        </div>
      </li>
      <li class="tn-rec-mini__linha">
        <span class="tn-home-mono">PT-0341</span>
        <span class="tn-home-status">Em revisão</span>
      </li>
    </ul>
    <div class="tn-rec-mini__rodape tn-home-rodape" data-anim="up">
      <span>2 de 3 pontos revisados</span>
      <span class="tn-home-rodape__link">CSV · GeoJSON · SHP →</span>
    </div>
  </div>
)}
