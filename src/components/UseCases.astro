---
import { Image } from "astro:assets";
import ucAgro from "../assets/uc-agro.png";
import ucAmbiental from "../assets/uc-ambiental.png";
import ucEnergia from "../assets/uc-energia.png";
import ucMunicipios from "../assets/uc-municipios.png";
import ucSaneamento from "../assets/uc-saneamento.png";
import ucTopografia from "../assets/uc-topografia.png";
---
<div class="tn-section tn-section--surface tn-section--border-top">
  <div class="tn-section__inner tn-uc" data-uc-root>

    <div class="tn-uc__header">
      <div class="tn-uc__eyebrow-row">
        <span class="tn-eyebrow">CASOS DE USO</span>
        <div class="tn-uc__rule"></div>
      </div>
      <div class="tn-uc__head-grid">
        <h2 class="tn-h2 tn-uc__h2">Seis levantamentos, o mesmo fluxo de trabalho</h2>
        <p class="tn-lead tn-uc__lead">Abra um levantamento para ver como a equipe monta o formulário e o que registra em campo.</p>
      </div>
    </div>

    <div class="tn-uc__split">

      <div class="tn-uc__stage">
        <Image src={ucTopografia} class="tn-uc__img is-active" data-uc="0"  alt="Topógrafo levantando divisa de propriedade rural com celular na mão" />
        <Image src={ucSaneamento} class="tn-uc__img" data-uc="1"  alt="Técnico de campo inspecionando torre de transmissão com celular" />
        <Image src={ucEnergia} class="tn-uc__img" data-uc="2"  alt="Técnica ambiental medindo árvore em inventário florestal com celular" />
        <Image src={ucMunicipios} class="tn-uc__img" data-uc="3"  alt="Agente municipal fotografando fachada de imóvel em recadastramento" />
        <Image src={ucAgro} class="tn-uc__img" data-uc="4"  alt="Agrônomo em lavoura de soja registrando talhão pelo celular" />
        <Image src={ucAmbiental} class="tn-uc__img" data-uc="5"  alt="Engenheiro fiscalizando vala de saneamento em obra com celular" />
        <div class="tn-uc__scrim"></div>
        <div class="tn-uc__badge">
          <span class="tn-uc__badge-dot"></span>
          <span class="tn-uc__badge-text" data-uc-caption>Topografia e cadastro</span>
        </div>
      </div>

      <div class="tn-uc__rows">
        <button class="tn-uc__row is-active" type="button" data-uc="0" aria-expanded="true" aria-controls="tn-uc-detail-0">
          <span class="tn-uc__track"><span class="tn-uc__fill"></span></span>
          <span class="tn-uc__row-head">
            <span class="tn-uc__num">01</span>
            <span class="tn-uc__meta">
              <span class="tn-uc__tag">Topografia e cadastro</span>
              <span class="tn-uc__title">Levantamentos e cadastro técnico</span>
            </span>
            <svg class="tn-uc__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="#FF6629" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </span>
          <span class="tn-uc__detail" id="tn-uc-detail-0">
            <span class="tn-uc__detail-inner">
              <span class="tn-uc__detail-text">Vértices, testadas e benfeitorias marcados com precisão, com croqui e foto anexados a cada ponto. O memorial descritivo sai do dado já validado, sem passar por planilha.</span>
              <span class="tn-uc__fields">
                <span class="tn-uc__fields-label">Campos típicos do formulário</span>
                <span class="tn-uc__chips">
                  <span class="tn-uc__chip">Vértice</span>
                  <span class="tn-uc__chip">Confrontante</span>
                  <span class="tn-uc__chip">Foto do marco</span>
                  <span class="tn-uc__chip">Área (m²)</span>
                </span>
              </span>
            </span>
          </span>
        </button>

        <button class="tn-uc__row" type="button" data-uc="1" aria-expanded="false" aria-controls="tn-uc-detail-1">
          <span class="tn-uc__track"><span class="tn-uc__fill"></span></span>
          <span class="tn-uc__row-head">
            <span class="tn-uc__num">02</span>
            <span class="tn-uc__meta">
              <span class="tn-uc__tag">Energia e telecom</span>
              <span class="tn-uc__title">Inspeção de redes e torres</span>
            </span>
            <svg class="tn-uc__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="#FF6629" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </span>
          <span class="tn-uc__detail" id="tn-uc-detail-1">
            <span class="tn-uc__detail-inner">
              <span class="tn-uc__detail-text">Uma ficha por estrutura: número da torre, estado dos componentes, fotos obrigatórias e ocorrências registradas com data, hora e responsável.</span>
              <span class="tn-uc__fields">
                <span class="tn-uc__fields-label">Campos típicos do formulário</span>
                <span class="tn-uc__chips">
                  <span class="tn-uc__chip">Nº da torre</span>
                  <span class="tn-uc__chip">Componente</span>
                  <span class="tn-uc__chip">Severidade</span>
                  <span class="tn-uc__chip">Fotos (mín. 3)</span>
                </span>
              </span>
            </span>
          </span>
        </button>

        <button class="tn-uc__row" type="button" data-uc="2" aria-expanded="false" aria-controls="tn-uc-detail-2">
          <span class="tn-uc__track"><span class="tn-uc__fill"></span></span>
          <span class="tn-uc__row-head">
            <span class="tn-uc__num">03</span>
            <span class="tn-uc__meta">
              <span class="tn-uc__tag">Meio ambiente</span>
              <span class="tn-uc__title">Licenciamento e monitoramento</span>
            </span>
            <svg class="tn-uc__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="#FF6629" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </span>
          <span class="tn-uc__detail" id="tn-uc-detail-2">
            <span class="tn-uc__detail-inner">
              <span class="tn-uc__detail-text">Inventário florestal, pontos de coleta de água e áreas de intervenção mapeados no formato que o relatório de licenciamento pede.</span>
              <span class="tn-uc__fields">
                <span class="tn-uc__fields-label">Campos típicos do formulário</span>
                <span class="tn-uc__chips">
                  <span class="tn-uc__chip">Espécie</span>
                  <span class="tn-uc__chip">CAP / altura</span>
                  <span class="tn-uc__chip">Ponto de coleta</span>
                  <span class="tn-uc__chip">Área de APP</span>
                </span>
              </span>
            </span>
          </span>
        </button>

        <button class="tn-uc__row" type="button" data-uc="3" aria-expanded="false" aria-controls="tn-uc-detail-3">
          <span class="tn-uc__track"><span class="tn-uc__fill"></span></span>
          <span class="tn-uc__row-head">
            <span class="tn-uc__num">04</span>
            <span class="tn-uc__meta">
              <span class="tn-uc__tag">Municípios</span>
              <span class="tn-uc__title">Cadastro imobiliário e IPTU</span>
            </span>
            <svg class="tn-uc__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="#FF6629" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </span>
          <span class="tn-uc__detail" id="tn-uc-detail-3">
            <span class="tn-uc__detail-inner">
              <span class="tn-uc__detail-text">Recadastramento porta a porta com formulário padronizado, foto da fachada e geometria do lote. Sem prancheta, sem redigitação no fim do dia.</span>
              <span class="tn-uc__fields">
                <span class="tn-uc__fields-label">Campos típicos do formulário</span>
                <span class="tn-uc__chips">
                  <span class="tn-uc__chip">Inscrição</span>
                  <span class="tn-uc__chip">Uso do imóvel</span>
                  <span class="tn-uc__chip">Fachada</span>
                  <span class="tn-uc__chip">Geometria do lote</span>
                </span>
              </span>
            </span>
          </span>
        </button>

        <button class="tn-uc__row" type="button" data-uc="4" aria-expanded="false" aria-controls="tn-uc-detail-4">
          <span class="tn-uc__track"><span class="tn-uc__fill"></span></span>
          <span class="tn-uc__row-head">
            <span class="tn-uc__num">05</span>
            <span class="tn-uc__meta">
              <span class="tn-uc__tag">Agro</span>
              <span class="tn-uc__title">Mapeamento de lavouras</span>
            </span>
            <svg class="tn-uc__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="#FF6629" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </span>
          <span class="tn-uc__detail" id="tn-uc-detail-4">
            <span class="tn-uc__detail-inner">
              <span class="tn-uc__detail-text">Talhões, focos de praga e amostragens de solo coletados offline pela equipe de campo e consolidados por safra no painel do agrônomo.</span>
              <span class="tn-uc__fields">
                <span class="tn-uc__fields-label">Campos típicos do formulário</span>
                <span class="tn-uc__chips">
                  <span class="tn-uc__chip">Talhão</span>
                  <span class="tn-uc__chip">Cultura</span>
                  <span class="tn-uc__chip">Praga / dano</span>
                  <span class="tn-uc__chip">Amostra de solo</span>
                </span>
              </span>
            </span>
          </span>
        </button>

        <button class="tn-uc__row" type="button" data-uc="5" aria-expanded="false" aria-controls="tn-uc-detail-5">
          <span class="tn-uc__track"><span class="tn-uc__fill"></span></span>
          <span class="tn-uc__row-head">
            <span class="tn-uc__num">06</span>
            <span class="tn-uc__meta">
              <span class="tn-uc__tag">Saneamento e obras</span>
              <span class="tn-uc__title">Fiscalização de infraestrutura</span>
            </span>
            <svg class="tn-uc__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="#FF6629" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </span>
          <span class="tn-uc__detail" id="tn-uc-detail-5">
            <span class="tn-uc__detail-inner">
              <span class="tn-uc__detail-text">Diário de obra georreferenciado: cada medição, ligação e não conformidade fica amarrada ao ponto exato, com histórico de quem registrou.</span>
              <span class="tn-uc__fields">
                <span class="tn-uc__fields-label">Campos típicos do formulário</span>
                <span class="tn-uc__chips">
                  <span class="tn-uc__chip">Serviço</span>
                  <span class="tn-uc__chip">Medição</span>
                  <span class="tn-uc__chip">Não conformidade</span>
                  <span class="tn-uc__chip">Assinatura</span>
                </span>
              </span>
            </span>
          </span>
        </button>

        <div class="tn-uc__foot">
          <span class="tn-uc__foot-text">Seu levantamento não está na lista? É só montar o formulário do seu jeito.</span>
          <a href="https://form.typeform.com/to/ZVQYTFV5" target="_blank" rel="noopener" data-mp-cta="use_cases_footer" class="tn-uc__foot-link">Entrar na lista de espera →</a>
        </div>
      </div>

    </div>

  </div>
</div>

<script is:inline>
(function () {
  // Use-case carousel. This platform's renderer periodically re-syncs the DOM against
  // the compiled template, replacing nodes and dropping anything JS put on them — so
  // nothing here caches element references or relies on listeners bound to a node.
  // Clicks are delegated on document, and a ticker re-paints whenever the renderer
  // has wiped our state (detected via the data-uc-painted marker it strips).
  var CYCLE = 7000;
  var active = 0;
  var pausedAt = 0;
  var remaining = CYCLE;
  var deadline = Date.now() + CYCLE;

  function root() { return document.querySelector('[data-uc-root]'); }
  function rowsOf(el) { return Array.prototype.slice.call(el.querySelectorAll('.tn-uc__row')); }

  function render(el, duration) {
    var rows = rowsOf(el);
    if (!rows.length) return;
    active = Math.max(0, Math.min(rows.length - 1, active));

    rows.forEach(function (row, i) {
      var on = i === active;
      row.classList.toggle('is-active', on);
      row.setAttribute('aria-expanded', on ? 'true' : 'false');
      var fill = row.querySelector('.tn-uc__fill');
      if (fill && !on) {
        fill.style.transition = 'none';
        fill.style.width = '0%';
      }
    });

    el.querySelectorAll('.tn-uc__img').forEach(function (img, i) {
      img.classList.toggle('is-active', i === active);
    });

    var caption = el.querySelector('[data-uc-caption]');
    var tag = rows[active].querySelector('.tn-uc__tag');
    if (caption && tag) caption.textContent = tag.textContent;

    runFill(rows[active], duration);
    el.setAttribute('data-uc-painted', String(active));
  }

  function runFill(row, duration) {
    var fill = row.querySelector('.tn-uc__fill');
    if (!fill) return;
    var from = duration < CYCLE ? 100 - (duration / CYCLE) * 100 : 0;
    fill.style.transition = 'none';
    fill.style.width = from + '%';
    if (pausedAt) return;
    requestAnimationFrame(function () {
      fill.style.transition = 'width ' + duration + 'ms linear';
      fill.style.width = '100%';
    });
  }

  function open(el, i) {
    active = i;
    remaining = CYCLE;
    deadline = Date.now() + CYCLE;
    pausedAt = 0;
    render(el, CYCLE);
  }

  document.addEventListener('click', function (e) {
    var row = e.target.closest && e.target.closest('.tn-uc__row');
    if (!row) return;
    var el = row.closest('[data-uc-root]');
    if (el) open(el, rowsOf(el).indexOf(row));
  });

  document.addEventListener('mouseover', function (e) {
    var el = e.target.closest && e.target.closest('[data-uc-root]');
    if (!el || pausedAt) return;
    pausedAt = Date.now();
    remaining = Math.max(0, deadline - pausedAt);
    var fill = rowsOf(el)[active] && rowsOf(el)[active].querySelector('.tn-uc__fill');
    if (fill) {
      var track = fill.parentElement.getBoundingClientRect().width || 1;
      fill.style.transition = 'none';
      fill.style.width = (fill.getBoundingClientRect().width / track * 100) + '%';
    }
  });

  document.addEventListener('mouseout', function (e) {
    var el = e.target.closest && e.target.closest('[data-uc-root]');
    if (!el || !pausedAt) return;
    if (e.relatedTarget && el.contains(e.relatedTarget)) return;
    pausedAt = 0;
    deadline = Date.now() + remaining;
    runFill(rowsOf(el)[active], remaining);
    remaining = CYCLE;
  });

  setInterval(function () {
    var el = root();
    if (!el) return;
    if (el.getAttribute('data-uc-painted') !== String(active)) {
      // Renderer wiped our state (or this is the first tick): repaint from scratch.
      render(el, pausedAt ? remaining : CYCLE);
      if (!pausedAt) deadline = Date.now() + CYCLE;
      return;
    }
    if (!pausedAt && Date.now() >= deadline) {
      active = (active + 1) % rowsOf(el).length;
      deadline = Date.now() + CYCLE;
      render(el, CYCLE);
    }
  }, 200);

})();
</script>
