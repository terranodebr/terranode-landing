---
import { Image } from "astro:assets";
import mobileCapture from "../assets/mobile-capture.png";
import mobileMap from "../assets/mobile-map.png";
import mobileSync from "../assets/mobile-sync.png";
import webOverview from "../assets/web-overview.png";
import webReview from "../assets/web-review.png";
---
<div class="tn-section tn-section--dark" id="produto">
  <div class="tn-section__inner tn-product__inner">

    <div class="tn-product__header-text">
      <span class="tn-eyebrow">O PRODUTO</span>
      <h2 class="tn-h2 tn-h2--on-dark">Um app para o campo. Um painel para o escritório.</h2>
      <p class="tn-lead tn-lead--on-dark">O mesmo projeto, visto de dois lugares. Quem coleta usa o aplicativo offline-first. Quem gerencia acompanha, revisa e valida pelo navegador.</p>
    </div>

    <div class="tn-pgrid tn-pgrid--web">
      <div class="tn-lift tn-pcard">
        <div class="tn-pcard__body">
          <span class="tn-pcard__tag">Painel web</span>
          <h3 class="tn-pcard__title">Visão geral do projeto</h3>
          <p class="tn-pcard__desc">Coleta, revisão e atividade da equipe em um painel só, com resumo por membro e progresso por levantamento.</p>
        </div>
        <div class="tn-pcard__shot">
          <Image src={webOverview} alt="Painel web: visão geral do projeto" />
        </div>
      </div>

      <div class="tn-lift tn-pcard">
        <div class="tn-pcard__body">
          <span class="tn-pcard__tag">Painel web</span>
          <h3 class="tn-pcard__title">Revisão de pontos</h3>
          <p class="tn-pcard__desc">Fila de pendentes, respostas lado a lado com o mapa e validação em um clique, sem sair da tela.</p>
        </div>
        <div class="tn-pcard__shot">
          <Image src={webReview} alt="Painel web: revisão de pontos" />
        </div>
      </div>
    </div>

    <div class="tn-pgrid tn-pgrid--app">
      <div class="tn-lift tn-pcard tn-pcard--compact">
        <div class="tn-pcard__body">
          <span class="tn-pcard__tag tn-pcard__tag--muted">App de campo</span>
          <h3 class="tn-pcard__title">Mapa em tempo real</h3>
          <p class="tn-pcard__desc">Pontos, linhas e polígonos sempre visíveis, mesmo sem conexão.</p>
        </div>
        <div class="tn-pcard__shot tn-pcard__shot--phone">
          <Image src={mobileMap} alt="App mobile: mapa de coleta" />
        </div>
      </div>

      <div class="tn-lift tn-pcard tn-pcard--compact">
        <div class="tn-pcard__body">
          <span class="tn-pcard__tag tn-pcard__tag--muted">App de campo</span>
          <h3 class="tn-pcard__title">Captura guiada</h3>
          <p class="tn-pcard__desc">O formulário certo para cada coletor, com validação no registro.</p>
        </div>
        <div class="tn-pcard__shot tn-pcard__shot--phone">
          <Image src={mobileCapture} alt="App mobile: captura de ponto" />
        </div>
      </div>

      <div class="tn-lift tn-pcard tn-pcard--compact">
        <div class="tn-pcard__body">
          <span class="tn-pcard__tag tn-pcard__tag--muted">App de campo</span>
          <h3 class="tn-pcard__title">Fila de sincronização</h3>
          <p class="tn-pcard__desc">Cada foto, áudio e ponto na fila, com progresso até o último item subir.</p>
        </div>
        <div class="tn-pcard__shot tn-pcard__shot--phone">
          <Image src={mobileSync} alt="App mobile: sincronização" />
        </div>
      </div>
    </div>

  </div>
</div>
