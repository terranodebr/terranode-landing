---
import "../styles/global.css";
import { asset } from "../lib/asset";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Path under public/, or an absolute URL. */
  image?: string;
  noindex?: boolean;
  /**
   * Colour of the last section above the footer. The footer opens in this colour and
   * fades into its own dark, so the two blend instead of meeting at a seam.
   */
  rodapeTopo?: string;
}

const {
  title,
  description,
  image = "/og-default.jpg",
  noindex = false,
  rodapeTopo,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// A path in public/ goes through asset() so PR previews point at their own copy rather
// than production's; an absolute URL is left as is.
const ogImage = new URL(/^https?:/.test(image) ? image : asset(image), Astro.site);

// PR previews publish under the production domain, so they must never be indexed.
// BASE_URL is always defined by Astro and reflects the `base` the site was built with.
const isPreview = import.meta.env.BASE_URL.startsWith("/pr-preview");
const blockIndexing = noindex || isPreview;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TerraNode",
  url: "https://terranode.com.br/",
  logo: new URL("/terranode-logo.svg", Astro.site).href,
  description:
    "Plataforma brasileira de coleta de dados geoespaciais em campo, offline-first.",
};

const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TerraNode",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Android, iOS, Web",
  inLanguage: "pt-BR",
  description:
    "Coleta de dados geoespaciais em campo, 100% offline e integrada ao ArcGIS Online e Enterprise. Arquivos criptografados no aparelho e no servidor, dados no Brasil e LGPD por arquitetura.",
  publisher: { "@type": "Organization", name: "TerraNode" },
};
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="TerraNode">
<meta name="robots" content={blockIndexing ? "noindex, nofollow" : "index, follow"}>
<meta name="theme-color" content="#1e3736">
<link rel="canonical" href={canonical.href}>
<link rel="icon" href={asset("/favicon.ico")} sizes="48x48">
<link rel="icon" href={asset("/favicon-32x32.png")} type="image/png" sizes="32x32">
<link rel="icon" href={asset("/favicon-96x96.png")} type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")}>
<link rel="sitemap" href={asset("/sitemap-index.xml")}>

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:url" content={canonical.href}>
<meta property="og:site_name" content="TerraNode">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage.href}>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage.href}>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
<script type="application/ld+json" set:html={JSON.stringify(software)} />

<!-- Mixpanel -->
<script is:inline>
  (function (f, b) { if (!b.__SV) { var e, g, i, h; window.mixpanel = b; b._i = []; b.init = function (e, f, c) { function g(a, d) { var b = d.split("."); 2 == b.length && ((a = a[b[0]]), (d = b[1])); a[d] = function () { a.push([d].concat(Array.prototype.slice.call(arguments, 0))); }; } var a = b; "undefined" !== typeof c ? (a = b[c] = []) : (c = "mixpanel"); a.people = a.people || []; a.toString = function (a) { var d = "mixpanel"; "mixpanel" !== c && (d += "." + c); a || (d += " (stub)"); return d; }; a.people.toString = function () { return a.toString(1) + ".people (stub)"; }; i = "disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" "); for (h = 0; h < i.length; h++) g(a, i[h]); var j = "set set_once union unset remove delete".split(" "); a.get_group = function () { function b(c) { d[c] = function () { call2_args = arguments; call2 = [c].concat(Array.prototype.slice.call(call2_args, 0)); a.push([e, call2]); }; } for (var d = {}, e = ["get_group"].concat(Array.prototype.slice.call(arguments, 0)), c = 0; c < j.length; c++) b(j[c]); return d; }; b._i.push([e, f, c]); }; b.__SV = 1.2; e = f.createElement("script"); e.type = "text/javascript"; e.async = !0; e.src = "undefined" !== typeof MIXPANEL_CUSTOM_LIB_URL ? MIXPANEL_CUSTOM_LIB_URL : "file:" === f.location.protocol && "//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js".match(/^\/\//) ? "https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js" : "//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js"; g = f.getElementsByTagName("script")[0]; g.parentNode.insertBefore(e, g); } })(document, window.mixpanel || []);
  mixpanel.init("ad1e9d9c72e7d6d0859638f2e122eb19", {
    track_pageview: true,
    persistence: "localStorage"
  });
</script>
</head>
<body>
<slot />
<Footer topo={rodapeTopo} />

<script is:inline>
// Links to a section of the page you're on scroll there instead of jumping. Covers bare
// "#id" links and the root-relative "/#id" ones the header uses. A sticky bar marked
// data-rolagem-offset is measured so the section lands just below it; reduced motion
// keeps the instant jump.
document.addEventListener('click', function (e) {
  if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
  var link = e.target.closest && e.target.closest('a[href*="#"]');
  if (!link || link.target === '_blank') return;
  var url = new URL(link.href, location.href);
  if (!url.hash || url.origin !== location.origin || url.pathname !== location.pathname) return;
  var alvo = document.getElementById(decodeURIComponent(url.hash.slice(1)));
  if (!alvo) return;
  e.preventDefault();
  var barra = document.querySelector('[data-rolagem-offset]');
  var folga = barra ? barra.getBoundingClientRect().height : 0;
  var reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  window.scrollTo({ top: alvo.getBoundingClientRect().top + window.scrollY - folga, behavior: reduzir ? 'auto' : 'smooth' });
  history.pushState(null, '', url.hash);
  // Move keyboard focus along with the view, as a native jump would.
  if (!alvo.hasAttribute('tabindex')) alvo.setAttribute('tabindex', '-1');
  alvo.focus({ preventScroll: true });
});
</script>

<script is:inline>
(function () {
  // Mixpanel events. Delegated on document because this platform's renderer replaces
  // nodes after the initial render, which would drop listeners bound to them directly.
  function track(event, props) {
    if (!window.mixpanel || typeof mixpanel.track !== 'function') return;
    mixpanel.track(event, props);
  }

  document.addEventListener('click', function (e) {
    if (!e.target.closest) return;

    var cta = e.target.closest('[data-mp-cta]');
    if (cta) {
      // Event name, attribute and cta_id vocabulary match the taxonomy already
      // live in Mixpanel — renaming would split the existing history.
      track('CTA Clicked', {
        cta_id: cta.getAttribute('data-mp-cta'),
        label: cta.textContent.trim(),
        destination: cta.getAttribute('href')
      });
      return;
    }

    // Only manual opens are tracked. The carousel also advances on its own every 7s,
    // and sending those would bury the intentional clicks under idle-tab noise.
    var row = e.target.closest('.tn-uc__row');
    if (row) {
      var rows = Array.prototype.slice.call(document.querySelectorAll('.tn-uc__row'));
      track('Use Case Opened', {
        use_case: (row.querySelector('.tn-uc__title') || {}).textContent,
        sector: (row.querySelector('.tn-uc__tag') || {}).textContent,
        position: rows.indexOf(row) + 1
      });
      return;
    }

    var step = e.target.closest('.tn-steps__stop');
    if (step) {
      var stops = Array.prototype.slice.call(document.querySelectorAll('.tn-steps__stop'));
      track('Step Opened', {
        step: (step.querySelector('.tn-steps__stop-label') || {}).textContent,
        position: stops.indexOf(step) + 1
      });
    }
  });
})();
</script>
</body>
</html>
